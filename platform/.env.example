# Copy this file to platform/.env and fill it in. Both the website and the
# MCP server read it. Never commit the real .env.

# Postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cevg

# Where people reach the site. Locally: http://localhost:3000
# Behind a tunnel or on a host: the https address.
SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Sign-in. AUTH_SECRET is any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# From Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI: <SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set to 1 on your own machine only, to sign in without Google while testing.
DEV_LOGIN=0

# Where videos and thumbnails are kept (an absolute path is safest).
CEVG_STORAGE=./storage

# Voice: Gnani (default) or Sarvam (CEVG_TTS=sarvam). Without a key, videos are silent with captions.
GNANI_API_KEY=
SARVAM_API_KEY=

# When the site and the render server run on different machines (Vercel and Railway):
# the site passes connector traffic to MCP_INTERNAL_URL and fetches videos from
# CEVG_FILES_URL/files/..., sending CEVG_INTERNAL_TOKEN, which both sides must share.
MCP_INTERNAL_URL=
CEVG_FILES_URL=
CEVG_INTERNAL_TOKEN=

# Limits and branding
CEVG_WATERMARK=Vivaran
CEVG_DAILY_VOICE_MINUTES=10
CEVG_MAX_MINUTES=12

# Before launch: 1 keeps every explanatory page up but closes sign-in, the dashboard
# and rendering, and puts a waitlist form on the front page.
WAITLIST=0
# Lets whoever runs the launch download the waitlist as CSV (see app/api/waitlist).
WAITLIST_ADMIN_TOKEN=
