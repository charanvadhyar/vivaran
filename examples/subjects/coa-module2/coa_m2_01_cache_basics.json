     "do": [
      {
       "action": "highlight",
       "target": "lines.tag"
      }
     ]
    },
    {
     "say": {
      "en": "It also stores a valid bit, which says whether the line holds anything real at all."
     },
     "do": [
      {
       "action": "highlight",
       "target": "lines.valid"
      }
     ]
    },
    {
     "say": {
      "en": "At power on, every valid bit is 0, so every lookup misses."
     },
     "do": [
      {
       "action": "highlight",
       "target": "lines.valid"
      }
     ]
    },
    {
     "say": {
      "en": "Here is the lookup for 0x1A7C."
     },
     "do": [
      {
       "action": "show",
       "target": "lookup"
      },
      {
       "action": "highlight",
       "target": "lookup.addr"
      }
     ]
    },
    {
     "say": {
      "en": "The index, 7, takes us straight to line 7, with no searching."
     },
     "do": [
      {
       "action": "highlight",
       "target": "lookup.idx"
      },
      {
       "action": "highlight",
       "target": "lines[2]",
       "delay": 0.4
      }
     ]
    },
    {
     "say": {
      "en": "Then one comparison: is the valid bit 1, and is the stored tag equal to 26?"
