  {
   "id": "placement",
   "steps": [
    {
     "say": {
      "en": "Stage 3, question one: where can a block be placed?"
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 3 of 7: Q1 placement"
      },
      {
       "action": "hide",
       "target": "spec"
      },
      {
       "action": "hide",
       "target": "calc"
      },
      {
       "action": "show",
       "target": "place"
      }
     ]
    },
    {
     "say": {
      "en": "In a direct-mapped cache, each block has exactly one line it may use."
     },
     "do": [
      {
       "action": "highlight",
       "target": "place[0]"
      }
     ]
    },
    {
     "say": {
      "en": "That line is the block number mod 16, the number of lines."
     },
     "do": [
      {
       "action": "highlight",
       "target": "place[0][2]"
      }
     ]
    },
    {
     "say": {
      "en": "In a set-associative cache, lines are grouped into sets, and a block may use any line of one set."
     },
     "do": [
      {
       "action": "highlight",
       "target": "place[1]"
      }
     ]
    },
    {
     "say": {
      "en": "With two lines per set, we call it two-way set-associative."
     },
     "do": [
      {
       "action": "highlight",
       "target": "place[1][0]"
      }
     ]
    },
    {
     "say": {
      "en": "In a fully associative cache, a block may go in any line at all."
     },
     "do": [
      {
       "action": "highlight",
       "target": "place[2]"
      }
     ]
    },
    {
     "say": {
      "en": "All three are the same idea: the number of sets is the number of blocks divided by the number of ways."
     },
     "do": [
      {
       "action": "show",
       "target": "placemath"
      }
     ]
    },
    {
     "say": {
      "en": "Direct-mapped is one way: 16 divided by 1 gives 16 sets of one line."
     },
     "do": [
      {
       "action": "reveal",
       "target": "placemath[1]"
      },
      {
       "action": "highlight",
       "target": "placemath[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Two-way: 16 divided by 2 gives 8 sets, so the rule is block mod 8."
     },
     "do": [
      {
       "action": "reveal",
       "target": "placemath[2]"
      },
      {
       "action": "highlight",
       "target": "placemath[2]"
      },
      {
       "action": "highlight",
       "target": "place[1][2]",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "Fully associative: 16 ways, so there is just one set, and no rule to follow."
     },
     "do": [
      {
       "action": "reveal",
       "target": "placemath[3]"
      },
      {
       "action": "highlight",
       "target": "placemath[3]"
      }
     ]
    },
    {
     "say": {
      "en": "So direct-mapped and fully associative are just the two ends of set-associative."
     },
     "do": [
      {
       "action": "replace",
       "target": "takeaway",
       "text": "direct-mapped = 1-way · fully associative = one set with every line"
      }
     ]
    }
   ]
  },
