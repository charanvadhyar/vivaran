    },
    {
     "say": {
      "en": "Addresses are 16 bits long, and every byte has its own address."
     },
     "do": [
      {
       "action": "highlight",
       "target": "spec[0..=1]"
      }
     ]
    },
    {
     "say": {
      "en": "The cache holds 256 bytes, moved in blocks of 16 bytes."
     },
     "do": [
      {
       "action": "highlight",
       "target": "spec[2..=3]"
      }
     ]
    },
    {
     "say": {
      "en": "A block is the unit the cache copies from memory, never a single byte."
     },
     "do": [
      {
       "action": "highlight",
       "target": "spec[3]"
      }
     ]
    },
    {
     "say": {
      "en": "First question: how many blocks fit in the cache?"
     },
     "do": [
      {
       "action": "show",
       "target": "calc"
      }
     ]
    },
    {
     "say": {
      "en": "Divide the cache size by the block size."
     },
     "do": [
      {
       "action": "highlight",
       "target": "calc[0]"
      }
     ]
    },
    {
     "say": {
      "en": "256 divided by 16 is 16, so the cache has 16 lines, each holding one block."
     },
     "do": [
      {
       "action": "reveal",
       "target": "calc[1]"
      },
      {
       "action": "highlight",
       "target": "calc[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Memory is split into blocks the same way: the block number is the address divided by 16, rounded down."
     },
     "do": [
      {
       "action": "reveal",
       "target": "calc[2]"
      },
      {
       "action": "highlight",
       "target": "calc[2]"
      }
     ]
    },
    {
     "say": {
      "en": "And the remainder, the offset, says which byte inside the block we want."
     },
     "do": [
      {
       "action": "reveal",
       "target": "calc[3]"
      },
      {
       "action": "highlight",
       "target": "calc[3]"
      }
     ]
    },
    {
     "say": {
      "en": "Keep these numbers: 16 lines, 16 bytes per block, 16 bit addresses."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "16 lines · 16-byte blocks · 16-bit addresses"
      }
     ]
    }
