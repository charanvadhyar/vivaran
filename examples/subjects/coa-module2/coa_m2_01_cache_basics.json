     "do": [
      {
       "action": "highlight",
       "target": "lookup.miss"
      }
     ]
    },
    {
     "say": {
      "en": "The cache fetches block 423 from memory, sets valid to 1, and stores tag 26."
     },
     "do": [
      {
       "action": "set",
       "target": "lines[2][1]",
       "value": "1"
      },
      {
       "action": "set",
       "target": "lines[2][2]",
       "value": "26",
       "delay": 0.3
      },
      {
       "action": "set",
       "target": "lines[2][3]",
       "value": "block 423",
       "delay": 0.6
      }
     ]
    },
    {
     "say": {
      "en": "The next read of 0x1A7C finds valid 1 and tag 26, so it is a hit, and byte 12 is returned."
