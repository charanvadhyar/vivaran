     ]
    }
   ]
  },
  {
   "id": "other-mappings",
   "steps": [
    {
     "say": {
      "en": "Stage 6: the same address in a two-way and a fully associative cache."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 6 of 7: the same address, other mappings"
      },
      {
       "action": "hide",
       "target": "lines"
      },
      {
       "action": "hide",
       "target": "lookup"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "cmp3"
      }
     ]
    },
    {
     "say": {
      "en": "Direct-mapped, from before: 16 sets, index 4 bits, tag 8 bits, line 7, tag 26."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cmp3[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Two-way has 8 sets, so the index is log base 2 of 8, which is 3 bits."
     },
     "do": [
      {
       "action": "show",
       "target": "math2"
      },
      {
       "action": "set",
       "target": "cmp3[1][2]",
       "value": "3"
      }
     ]
    },
    {
     "say": {
      "en": "The tag grows by one bit: 16 minus 3 minus 4 is 9."
     },
     "do": [
      {
       "action": "set",
       "target": "cmp3[1][3]",
       "value": "9"
      }
     ]
    },
    {
     "say": {
      "en": "The set is block 423 mod 8: 8 times 52 is 416, leaving 7, so set 7."
     },
     "do": [
      {
       "action": "set",
       "target": "cmp3[1][5]",
       "value": "set 7, either way"
      }
     ]
    },
    {
     "say": {
      "en": "The tag is the top 9 bits, which is 423 divided by 8, rounded down: 52."
     },
     "do": [
      {
       "action": "set",
       "target": "cmp3[1][6]",
       "value": "52"
      }
     ]
    },
    {
     "say": {
      "en": "Fully associative has one set, so the index is log base 2 of 1, which is zero bits."
     },
     "do": [
      {
       "action": "reveal",
       "target": "math2[1]"
      },
      {
       "action": "set",
       "target": "cmp3[2][2]",
       "value": "0"
      }
     ]
    },
    {
     "say": {
      "en": "Everything above the offset is tag: 16 minus 4 gives 12 bits."
     },
     "do": [
      {
       "action": "set",
       "target": "cmp3[2][3]",
       "value": "12"
      }
     ]
    },
    {
     "say": {
      "en": "The block may go in any line, and the stored tag is the whole block number, 423."
     },
     "do": [
      {
       "action": "set",
       "target": "cmp3[2][5]",
       "value": "any line"
      },
      {
       "action": "set",
       "target": "cmp3[2][6]",
       "value": "423"
      }
     ]
    },
    {
     "say": {
      "en": "Check the pattern: each time the ways double, the index loses a bit and the tag gains one."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cmp3.c2"
      },
      {
       "action": "highlight",
       "target": "cmp3.c3",
       "delay": 0.4
      }
     ]
    },
    {
     "say": {
      "en": "The offset never changes, because the block size did not change."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cmp3.c4"
      }
     ]
    }
   ]
  },
  {
   "id": "conflict",
   "steps": [
    {
     "say": {
      "en": "Stage 7: why pay for associativity? Watch two addresses fight over one line."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 7 of 7: a conflict"
      },
      {
       "action": "hide",
       "target": "cmp3"
      },
      {
       "action": "hide",
       "target": "math2"
      },
      {
       "action": "show",
       "target": "trace"
      }
     ]
    },
    {
     "say": {
      "en": "The processor reads 0x1A7C, then 0x2A70, then each again."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trace.address"
      }
     ]
    },
    {
     "say": {
      "en": "0x1A7C is block 423, as we found."
     },
     "do": [
      {
       "action": "set",
       "target": "trace[0][2]",
       "value": "423"
      },
      {
       "action": "set",
       "target": "trace[2][2]",
       "value": "423"
      }
     ]
    },
    {
     "say": {
      "en": "0x2A70 is 10864, and 10864 divided by 16 is block 679."
     },
     "do": [
      {
       "action": "set",
       "target": "trace[1][2]",
       "value": "679"
      },
      {
       "action": "set",
       "target": "trace[3][2]",
       "value": "679"
      }
     ]
    },
    {
     "say": {
      "en": "Direct-mapped: 423 mod 16 is 7, and 679 mod 16 is also 7."
     },
     "do": [
      {
       "action": "set",
       "target": "trace[0][3]",
       "value": "7"
      },
      {
       "action": "set",
       "target": "trace[1][3]",
       "value": "7"
      },
      {
       "action": "set",
       "target": "trace[2][3]",
       "value": "7"
      },
      {
       "action": "set",
       "target": "trace[3][3]",
       "value": "7"
      }
     ]
    },
    {
     "say": {
      "en": "Access one misses, and line 7 gets block 423."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trace[0]"
      },
      {
       "action": "set",
       "target": "trace[0][4]",
       "value": "miss"
      }
     ]
    },
    {
     "say": {
      "en": "Access two also needs line 7, so it misses and throws block 423 out."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trace[1]"
      },
      {
       "action": "set",
       "target": "trace[1][4]",
       "value": "miss"
      }
     ]
    },
    {
     "say": {
      "en": "Access three wants 423 back: miss again, and 679 is thrown out."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trace[2]"
      },
      {
       "action": "set",
       "target": "trace[2][4]",
       "value": "miss"
      }
     ]
    },
    {
     "say": {
      "en": "Access four misses too: four accesses, four misses, while the other 15 lines sit empty."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trace[3]"
      },
      {
       "action": "set",
       "target": "trace[3][4]",
       "value": "miss"
      },
      {
       "action": "mark",
       "target": "trace.c4",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "These are conflict misses: the cache had room, but the mapping forced both blocks into one line."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "conflict miss: room in the cache, but two blocks map to the same line"
      }
     ]
    },
    {
     "say": {
      "en": "Now two-way: 423 mod 8 is 7, and 679 mod 8 is also 7, the same set."
     },
     "do": [
      {
       "action": "set",
       "target": "trace[0][5]",
       "value": "7"
      },
      {
       "action": "set",
       "target": "trace[1][5]",
       "value": "7"
      },
      {
       "action": "set",
       "target": "trace[2][5]",
       "value": "7"
      },
      {
       "action": "set",
       "target": "trace[3][5]",
       "value": "7"
      }
     ]
    },
    {
     "say": {
      "en": "But set 7 has two ways, so access one misses into way 0, and access two misses into way 1."
     },
     "do": [
      {
       "action": "set",
       "target": "trace[0][6]",
       "value": "miss"
      },
      {
       "action": "set",
       "target": "trace[1][6]",
       "value": "miss",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "Both blocks now live side by side, so accesses three and four hit."
     },
     "do": [
      {
       "action": "set",
       "target": "trace[2][6]",
       "value": "hit"
      },
      {
       "action": "set",
       "target": "trace[3][6]",
       "value": "hit",
       "delay": 0.4
      },
      {
       "action": "mark",
       "target": "trace.c6",
       "delay": 0.6
      }
     ]
    },
    {
     "say": {
      "en": "Check: direct-mapped scored 0 hits out of 4, two-way scored 2 out of 4."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trace.c4"
      },
      {
       "action": "highlight",
       "target": "trace.c6",
       "delay": 0.5
      }
     ]
    }
   ]
  },
  {
   "id": "tradeoffs",
   "steps": [
    {
     "say": {
      "en": "So why not always use fully associative? Because every way costs hardware and time."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "The trade-off"
      },
      {
       "action": "hide",
       "target": "trace"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "trade"
      }
     ]
    },
    {
     "say": {
      "en": "Direct-mapped compares one tag per lookup; two-way compares two at once; fully associative compares all 16."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trade[0]"
      }
     ]
    },
    {
     "say": {
      "en": "More ways means fewer conflict misses."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trade[1]"
      }
     ]
    },
    {
     "say": {
      "en": "But more comparators and a final choice between ways make the hit time longer."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trade[2]"
      }
     ]
    },
    {
     "say": {
      "en": "And every line stores a longer tag: 8, 9, then 12 bits in our cache."
     },
     "do": [
      {
       "action": "highlight",
       "target": "trade[3]"
      }
     ]
    },
    {
     "say": {
      "en": "That is why real first-level caches are usually 2 to 8 way set-associative: a balance between the two ends."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "real L1 caches: 2-way to 8-way set-associative"
      }
     ]
    }
   ]
  },
  {
   "id": "exam",
   "steps": [
    {
     "say": {
      "en": "Now an exam question, the way it is usually asked."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Exam question"
      },
      {
       "action": "hide",
       "target": "trade"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "q"
      }
     ]
    },
    {
     "say": {
      "en": "A 32 kilobyte, 4-way set-associative cache with 64 byte blocks and 32 bit addresses. Find the sets, offset, index and tag."
     },
     "do": [
      {
       "action": "highlight",
       "target": "q[0..=3]"
      }
     ]
    },
    {
     "say": {
      "en": "Pause here and try it, then check each line with me."
     }
    },
    {
     "say": {
      "en": "First, 32 kilobytes is 32 times 1024, which is 32768 bytes."
     },
     "do": [
      {
       "action": "highlight",
       "target": "q[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Blocks: 32768 divided by 64 is 512 blocks."
     },
     "do": [
      {
       "action": "show",
       "target": "qa"
      },
      {
       "action": "highlight",
       "target": "qa[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Sets: 4-way means 4 blocks per set, so 512 divided by 4 is 128 sets."
     },
     "do": [
      {
       "action": "reveal",
       "target": "qa[1]"
      },
      {
       "action": "highlight",
       "target": "qa[1]"
      },
      {
       "action": "highlight",
       "target": "q[1]",
       "delay": 0.3
      }
     ]
    },
    {
     "say": {
      "en": "Offset: the block is 64 bytes, and 2 to the 6 is 64, so 6 bits."
     },
     "do": [
      {
       "action": "reveal",
       "target": "qa[2]"
      },
      {
       "action": "highlight",
       "target": "qa[2]"
      },
      {
       "action": "highlight",
       "target": "q[2]",
       "delay": 0.3
      }
     ]
    },
    {
     "say": {
      "en": "Index: 128 sets, and 2 to the 7 is 128, so 7 bits."
     },
     "do": [
      {
       "action": "reveal",
       "target": "qa[3]"
      },
      {
       "action": "highlight",
       "target": "qa[3]"
      }
     ]
    },
    {
     "say": {
      "en": "Tag: the rest of the address, 32 minus 7 minus 6, which is 19 bits."
     },
     "do": [
      {
       "action": "reveal",
       "target": "qa[4]"
      },
      {
       "action": "highlight",
       "target": "qa[4]"
      },
      {
       "action": "highlight",
       "target": "q[3]",
       "delay": 0.3
      }
     ]
    },
    {
     "say": {
      "en": "Check: 19 plus 7 plus 6 gives back all 32 address bits."
     },
     "do": [
      {
       "action": "show",
       "target": "qcheck"
      },
      {
       "action": "mark",
       "target": "qcheck[0]"
      }
     ]
    },
    {
     "say": {
      "en": "The usual mistake is forgetting to divide by the ways: the index counts sets, not blocks, and using 512 gives a wrong 9-bit index."
     },
     "do": [
      {
       "action": "mark",
       "target": "qa[1]"
      }
     ]
    }
   ]
  },
  {
   "id": "recap",
   "steps": [
    {
     "say": {
      "en": "Let us walk the stages once more."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Recap"
      },
      {
       "action": "hide",
       "target": "q"
      },
      {
       "action": "hide",
       "target": "qa"
      },
      {
       "action": "hide",
       "target": "qcheck"
      },
      {
       "action": "show",
       "target": "stages"
      }
     ]
    },
    {
     "say": {
      "en": "Four questions: placement, identification, replacement and write strategy."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Lines equal cache size over block size; sets equal lines over ways."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[1..=2]"
      }
     ]
    },
    {
     "say": {
      "en": "Offset bits are log of the block size, index bits are log of the sets, and the tag is what is left."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[3]"
      }
     ]
    },
    {
     "say": {
      "en": "The index finds the set, the valid bit and tag confirm the block, and the offset picks the byte."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[4]"
      }
     ]
