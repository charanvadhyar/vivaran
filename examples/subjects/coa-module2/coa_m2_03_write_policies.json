       "action": "highlight",
       "target": "qt[1]"
      },
      {
       "action": "set",
       "target": "qt[1][1]",
       "value": "hit",
       "delay": 0.3
      },
      {
       "action": "set",
       "target": "qt[1][2]",
       "value": "miss: word write",
       "delay": 0.6
      }
