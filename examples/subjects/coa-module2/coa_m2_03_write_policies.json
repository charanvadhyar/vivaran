      }
     ]
    },
    {
     "say": {
      "en": "Why writes are hard, then write-through with its write buffer, and write-back with its dirty bit, each animated step by step."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[0..=3]"
      }
     ]
    },
    {
     "say": {
