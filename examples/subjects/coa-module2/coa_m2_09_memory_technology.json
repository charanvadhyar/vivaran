     "do": [
      {
       "action": "reveal",
       "target": "ddr[3]"
      },
      {
       "action": "highlight",
       "target": "ddr[3]"
      }
     ]
    },
    {
     "say": {
      "en": "So a miss that hits a row conflict costs 42 plus 2.5, about 44.5 nanoseconds. The latency, not the bandwidth, dominates a single miss."
     },
     "do": [
      {
       "action": "reveal",
       "target": "ddr[4]"
      },
      {
       "action": "highlight",
       "target": "ddr[4]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "bandwidth = MT/s × 8 B per channel · latency dominates one miss"
      }
     ]
    }
   ]
  },
  {
   "id": "hbm",
   "steps": [
    {
     "say": {
      "en": "Stage 7: other memories."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 7 of 8: GDDR, HBM and flash"
