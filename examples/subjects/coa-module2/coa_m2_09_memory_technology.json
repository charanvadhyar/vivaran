      {
       "action": "highlight",
       "target": "ddrx[3]"
      }
     ]
    },
    {
     "say": {
      "en": "Where does that come from? Bandwidth is transfers per second, times the bus width in bytes."
     },
     "do": [
      {
       "action": "hide",
       "target": "ddrx"
      },
      {
       "action": "show",
       "target": "ddr"
      },
      {
       "action": "highlight",
       "target": "ddr[0]"
      }
     ]
    },
    {
     "say": {
      "en": "A channel is 64 bits, 8 bytes, wide. 3200 million times 8 is 25.6 gigabytes per second."
