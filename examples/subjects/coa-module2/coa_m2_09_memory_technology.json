     "do": [
      {
       "action": "reveal",
       "target": "ddr[1]"
      },
      {
       "action": "highlight",
       "target": "ddr[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Two channels double it, 51.2. DDR5-4800 gives 38.4 per module."
     },
     "do": [
      {
       "action": "reveal",
       "target": "ddr[2]"
      },
      {
       "action": "highlight",
       "target": "ddr[2]"
      }
     ]
    },
    {
     "say": {
      "en": "A 64 byte cache block is 8 transfers, a burst of 8. At 3200 million per second, that takes 2.5 nanoseconds."
