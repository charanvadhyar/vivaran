  {
   "id": "metrics",
   "steps": [
    {
     "say": {
      "en": "Stage 1: memory is measured two ways."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 1 of 8: latency and bandwidth"
      },
      {
       "action": "hide",
       "target": "stages"
      },
      {
       "action": "show",
       "target": "met"
      }
     ]
    },
    {
     "say": {
      "en": "Access time: from the request until the data appears. This is what a miss waits for."
     },
     "do": [
      {
       "action": "highlight",
       "target": "met[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Cycle time: the minimum gap between two requests. For DRAM it is longer than the access time, because a read must be followed by restoring the row."
     },
     "do": [
      {
       "action": "highlight",
       "target": "met[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Bandwidth: how many bytes per second flow once data starts. It decides how fast a whole block arrives."
     },
     "do": [
      {
       "action": "highlight",
       "target": "met[2]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "miss penalty ≈ latency + block size ÷ bandwidth"
      }
     ]
    }
   ]
  },
  {
   "id": "cells",
   "steps": [
    {
     "say": {
      "en": "Stage 2: two kinds of memory cell."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 2 of 8: SRAM and DRAM"
      },
      {
       "action": "hide",
       "target": "met"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "cell"
      },
      {
       "action": "highlight",
       "target": "cell[0]"
      }
     ]
    },
    {
     "say": {
      "en": "SRAM stores a bit in 6 transistors, two cross-coupled inverters. DRAM stores it as charge on a capacitor, with one transistor to reach it."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cell[0][1]"
      },
      {
       "action": "highlight",
       "target": "cell[0][2]",
       "delay": 0.4
      }
     ]
    },
    {
     "say": {
      "en": "SRAM holds its value while powered. DRAM's charge leaks away, so every cell must be refreshed, many times a second."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cell[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Reading a DRAM cell drains it, so the value must be written back after every read. That is why its cycle time exceeds its access time."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cell[2]"
      }
     ]
    },
    {
     "say": {
      "en": "So SRAM is fast but large and costly. DRAM is slower, but several times denser and much cheaper per bit."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cell[3..=4]"
      }
     ]
    },
    {
     "say": {
      "en": "Hence SRAM for caches and registers, DRAM for main memory."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cell[5]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "SRAM: 6T, fast, caches · DRAM: 1T1C, dense, refresh, main memory"
      }
     ]
    }
   ]
  },
  {
   "id": "org",
   "steps": [
    {
     "say": {
      "en": "Stage 3: inside a DRAM chip. Cells are arranged in banks, each a grid of rows and columns, with one row buffer per bank."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 3 of 8: banks, rows and the row buffer"
      },
      {
       "action": "hide",
       "target": "cell"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "bank"
      },
      {
       "action": "show",
       "target": "bx"
      }
     ]
    },
    {
     "say": {
      "en": "To read, the controller first sends ACTIVATE with the row address. This is the old row address strobe, RAS."
     },
     "do": [
      {
       "action": "highlight",
       "target": "bx[0]"
      },
      {
       "action": "highlight",
       "target": "bank[2]",
       "delay": 0.3
      }
     ]
    },
    {
     "say": {
      "en": "The whole row, thousands of bits, is copied into the row buffer."
     },
     "do": [
      {
       "action": "set",
       "target": "bank[4][1]",
       "value": "row 2 (open)"
      },
      {
       "action": "highlight",
       "target": "bank[4]",
       "delay": 0.3
      }
     ]
    },
    {
     "say": {
      "en": "Then READ with the column address, the column strobe, CAS, picks the wanted bytes out of the row buffer."
     },
     "do": [
      {
       "action": "highlight",
       "target": "bx[1]"
      },
      {
       "action": "highlight",
       "target": "bank[4][1]",
       "delay": 0.3
      }
     ]
    },
    {
     "say": {
      "en": "Before another row of the same bank can be opened, PRECHARGE writes the open row back and empties the buffer."
     },
     "do": [
      {
       "action": "highlight",
       "target": "bx[2]"
      },
      {
       "action": "set",
       "target": "bank[4][1]",
       "value": "(empty)",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "Row and column addresses share the same pins, sent one after the other. That address multiplexing halves the pin count."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "ACTIVATE (row) → READ (column) → PRECHARGE"
      }
     ]
    },
    {
     "say": {
      "en": "And because each bank has its own row buffer, several banks can work at once: the interleaving we used in the AMAT video."
     },
     "do": [
      {
       "action": "highlight",
       "target": "bank"
      }
     ]
    }
   ]
  },
  {
   "id": "timing",
   "steps": [
    {
     "say": {
      "en": "Stage 4: so the time for an access depends on the row buffer. Assume each command takes about 14 nanoseconds."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 4 of 8: three kinds of access"
      },
      {
       "action": "hide",
       "target": "bank"
      },
      {
       "action": "hide",
       "target": "bx"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "acc"
      }
     ]
    },
    {
     "say": {
      "en": "A row hit: the row is already open, so only the column read is needed. About 14 nanoseconds."
     },
     "do": [
      {
       "action": "add_block",
       "target": "acc",
       "id": "h1",
       "lane": "row hit: row already open",
       "start": 0,
       "end": 14,
       "label": "READ 14"
      }
     ]
    },
    {
     "say": {
      "en": "A closed row: activate it, then read. 28 nanoseconds."
     },
     "do": [
      {
       "action": "add_block",
       "target": "acc",
       "id": "c1",
       "lane": "row closed",
       "start": 0,
       "end": 14,
       "label": "ACTIVATE 14"
      },
      {
       "action": "add_block",
       "target": "acc",
       "id": "c2",
       "lane": "row closed",
       "start": 14,
       "end": 28,
       "label": "READ 14",
       "delay": 0.3
      }
     ]
    },
    {
     "say": {
      "en": "A row conflict: another row is open. Precharge it, activate ours, then read. 42 nanoseconds, three times a row hit."
     },
     "do": [
      {
       "action": "add_block",
       "target": "acc",
       "id": "x1",
       "lane": "row conflict: another row open",
       "start": 0,
       "end": 14,
       "label": "PRECHARGE 14"
      },
      {
       "action": "add_block",
       "target": "acc",
       "id": "x2",
       "lane": "row conflict: another row open",
       "start": 14,
       "end": 28,
       "label": "ACTIVATE 14",
       "delay": 0.3
      },
      {
       "action": "add_block",
       "target": "acc",
       "id": "x3",
       "lane": "row conflict: another row open",
       "start": 28,
       "end": 42,
       "label": "READ 14",
       "delay": 0.6
      }
     ]
    },
    {
     "say": {
      "en": "That is why memory controllers reorder requests to hit open rows, and why accessing memory in order is so much faster than jumping around."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "row hit ≈ 1 step · closed ≈ 2 · conflict ≈ 3"
      }
     ]
    }
   ]
  },
  {
   "id": "refresh",
   "steps": [
    {
     "say": {
      "en": "Stage 5: refresh. Every DRAM row must be read and rewritten before its charge leaks, typically every 64 milliseconds."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 5 of 8: refresh"
      },
      {
       "action": "hide",
       "target": "acc"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "ref"
      },
      {
       "action": "highlight",
       "target": "ref[0]"
      }
     ]
    },
    {
     "say": {
      "en": "With 8192 rows, a row refresh must start about every 7.8 microseconds."
     },
     "do": [
      {
       "action": "reveal",
       "target": "ref[1]"
      },
      {
       "action": "highlight",
       "target": "ref[1]"
      }
     ]
    },
    {
     "say": {
      "en": "If each refresh keeps the bank busy for 50 nanoseconds, that is 8192 times 50 nanoseconds every 64 milliseconds: about 0.64 percent of the time lost."
     },
     "do": [
      {
       "action": "reveal",
       "target": "ref[2]"
      },
      {
       "action": "highlight",
       "target": "ref[2]"
      }
     ]
    },
    {
     "say": {
      "en": "Small, but it grows with bigger chips, and an access that arrives during a refresh must wait."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "refresh interval = retention time ÷ rows"
      }
     ]
    }
   ]
  },
  {
   "id": "ddr",
   "steps": [
    {
     "say": {
      "en": "Stage 6: modern DRAM is synchronous, SDRAM, and double data rate, DDR."
