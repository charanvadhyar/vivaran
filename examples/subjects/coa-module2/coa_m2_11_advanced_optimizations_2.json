       "target": "ptm[1]"
      },
      {
       "action": "highlight",
       "target": "ptm[1]"
      }
     ]
    },
    {
     "say": {
      "en": "The costs: prefetches use memory bandwidth, and a wrong guess can push useful blocks out. So prefetchers back off when their guesses keep missing."
     },
     "do": [
      {
       "action": "reveal",
       "target": "ptm[2]"
      },
      {
       "action": "highlight",
       "target": "ptm[2]"
