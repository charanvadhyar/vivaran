  },
  {
   "id": "swpf",
   "steps": [
    {
     "say": {
      "en": "Stage 5: compiler-controlled prefetching. The compiler inserts prefetch instructions, because it can see the loop's future addresses."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 5 of 8: compiler-controlled prefetching"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "hide",
       "target": "ptm"
      },
      {
       "action": "show",
       "target": "cpx"
      },
      {
       "action": "highlight",
       "target": "cpx[0]"
      }
     ]
    },
    {
     "say": {
      "en": "A cache prefetch only brings the block into the cache. A register prefetch loads the value itself."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cpx[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Prefetches are nonfaulting: a bad address is ignored rather than crashing the program. And the cache must be nonblocking, so the CPU runs on while they are in flight."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cpx[2]"
      },
      {
       "action": "highlight",
       "target": "cpx[3]",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "The textbook's example. a is 3 by 100, b is 101 by 3, all 8 byte doubles, in an 8 kilobyte direct-mapped cache with 16 byte blocks."
     },
     "do": [
      {
       "action": "hide",
       "target": "cpx"
      },
      {
       "action": "show",
       "target": "cp"
      },
