  {
   "id": "lim",
   "type": "math",
   "region": "center",
   "lines": [
    "\"column order:\" quad 5000 times 100 = 500000 \"misses\"",
    "\"row order:\" quad 500000 / 8 = 62500 \"misses\" quad \"8 times fewer\""
   ]
  },
  {
   "id": "bl1",
   "type": "code",
   "region": "center",
   "language": "c",
   "lines": [
    "/* x = y * z, all N x N */",
    "for (i = 0; i < N; i++)",
    "  for (j = 0; j < N; j++) {",
    "    r = 0;",
    "    for (k = 0; k < N; k++)",
    "      r = r + y[i][k] * z[k][j];",
    "    x[i][j] = r;",
    "  }"
   ]
  },
  {
   "id": "bl2",
   "type": "code",
   "region": "center",
   "language": "c",
   "lines": [
    "/* blocked: work on B x B tiles */",
    "for (jj = 0; jj < N; jj += B)",
    "  for (kk = 0; kk < N; kk += B)",
    "    for (i = 0; i < N; i++)",
    "      for (j = jj; j < min(jj + B, N); j++) {",
    "        r = 0;",
    "        for (k = kk; k < min(kk + B, N); k++)",
    "          r = r + y[i][k] * z[k][j];",
    "        x[i][j] = x[i][j] + r;",
    "      }"
   ]
  },
  {
   "id": "blm",
   "type": "math",
   "region": "center",
   "lines": [
