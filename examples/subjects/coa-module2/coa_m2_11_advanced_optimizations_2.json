       "action": "hide",
       "target": "hp"
      },
      {
       "action": "show",
       "target": "pt"
      }
     ]
    },
    {
     "say": {
      "en": "Without prefetching: miss, wait 30, compute 30. Again and again. Three iterations take 180 cycles."
     },
     "do": [
      {
       "action": "add_block",
       "target": "pt",
       "id": "n0",
       "lane": "no prefetch: CPU",
       "start": 0,
       "end": 30,
       "label": "miss"
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "n1",
       "lane": "no prefetch: CPU",
       "start": 30,
       "end": 60,
       "label": "iter 1",
       "delay": 0.15
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "n2",
       "lane": "no prefetch: CPU",
       "start": 60,
       "end": 90,
       "label": "miss",
       "delay": 0.3
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "n3",
       "lane": "no prefetch: CPU",
       "start": 90,
       "end": 120,
       "label": "iter 2",
       "delay": 0.45
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "n4",
       "lane": "no prefetch: CPU",
       "start": 120,
       "end": 150,
       "label": "miss",
       "delay": 0.6
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "n5",
       "lane": "no prefetch: CPU",
       "start": 150,
       "end": 180,
       "label": "iter 3",
       "delay": 0.75
      }
     ]
    },
    {
     "say": {
      "en": "With prefetching one block ahead: the first miss still waits. But while iteration 1 computes, the next block is already on its way."
     },
     "do": [
      {
       "action": "add_block",
       "target": "pt",
       "id": "p0",
       "lane": "prefetch: CPU",
       "start": 0,
       "end": 30,
       "label": "miss"
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "m0",
       "lane": "prefetch: memory",
       "start": 0,
       "end": 30,
       "label": "block 1",
       "delay": 0.1
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "p1",
       "lane": "prefetch: CPU",
       "start": 30,
       "end": 60,
       "label": "iter 1",
       "delay": 0.3
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "m1",
       "lane": "prefetch: memory",
       "start": 30,
       "end": 60,
       "label": "block 2",
       "delay": 0.4
      }
     ]
    },
    {
     "say": {
      "en": "Each block arrives just as it is needed. Three iterations take 120 cycles instead of 180."
     },
     "do": [
      {
       "action": "add_block",
       "target": "pt",
       "id": "p2",
       "lane": "prefetch: CPU",
       "start": 60,
       "end": 90,
       "label": "iter 2"
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "m2",
       "lane": "prefetch: memory",
       "start": 60,
       "end": 90,
       "label": "block 3",
       "delay": 0.2
      },
      {
       "action": "add_block",
       "target": "pt",
       "id": "p3",
       "lane": "prefetch: CPU",
       "start": 90,
       "end": 120,
       "label": "iter 3",
       "delay": 0.4
      }
     ]
    },
    {
     "say": {
      "en": "How far ahead to prefetch? Memory latency over the time per iteration, rounded up."
     },
     "do": [
      {
       "action": "hide",
       "target": "pt"
      },
      {
       "action": "show",
       "target": "ptm"
      },
      {
       "action": "highlight",
       "target": "ptm[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Latency 30 with 30 cycle iterations: one ahead. If latency were 90, three ahead."
