      {
       "action": "reveal",
       "target": "cpm[1]"
      },
      {
       "action": "highlight",
       "target": "cpm[1]"
      },
      {
       "action": "hide",
       "target": "cp"
      }
     ]
    },
    {
     "say": {
      "en": "b is read down column 0: b of j, 0 and b of j plus 1, 0. 101 different blocks, missed only on the first pass of i. 251 misses in all."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cpm[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Now the compiler adds prefetches for a and b, 7 iterations ahead. Only the first 7 iterations of each row still miss: 7 for b, and 4 for each row of a. 19 misses."
