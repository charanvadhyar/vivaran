  {
   "id": "why",
   "steps": [
    {
     "say": {
      "en": "Stage 1: why do writes need their own rules?"
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 1 of 6: why writes are different"
      },
      {
       "action": "hide",
       "target": "stages"
      }
     ]
    },
    {
     "say": {
      "en": "On a read, the cache can read the data while it checks the tag, and simply ignore it on a miss."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "read: read data and check the tag at the same time"
      }
     ]
    },
    {
     "say": {
      "en": "A write cannot do that: changing the block before the tag matches would destroy someone else's data."
     },
     "do": [
      {
       "action": "replace",
       "target": "takeaway",
       "text": "write: the tag must match before the block is changed"
      }
     ]
    },
    {
     "say": {
      "en": "And a write makes the cache and memory disagree, unless we decide when memory is updated."
     }
    },
    {
     "say": {
      "en": "So there are two decisions: what to do on a write hit, and what to do on a write miss."
     },
     "do": [
      {
       "action": "replace",
       "target": "takeaway",
       "text": "two decisions: on a write hit · on a write miss"
      }
     ]
    }
   ]
  },
  {
   "id": "write-hit",
   "steps": [
    {
     "say": {
      "en": "Stage 2: on a write hit, the block is in the cache. When does memory get the new value?"
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 2 of 6: on a write hit"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "hitpol"
      }
     ]
    },
    {
     "say": {
      "en": "Write-through updates the cache and memory on every write."
     },
     "do": [
      {
       "action": "highlight",
       "target": "hitpol[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Memory is always up to date, which makes the design simple."
     },
     "do": [
      {
       "action": "highlight",
       "target": "hitpol[0][2]"
      }
     ]
    },
    {
     "say": {
      "en": "But every write now waits for slow memory, so a write buffer holds writes while the processor carries on."
     },
     "do": [
      {
       "action": "highlight",
       "target": "hitpol[0][3]"
      }
     ]
    },
    {
     "say": {
      "en": "Write-back updates only the cache, and writes the whole block to memory when it is evicted."
     },
     "do": [
      {
       "action": "highlight",
       "target": "hitpol[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Each line gets a dirty bit, set on a write, so only changed blocks are written back."
     },
     "do": [
      {
       "action": "highlight",
       "target": "hitpol[1][3]"
      }
     ]
    },
    {
     "say": {
      "en": "A clean block, one that was only read, is simply dropped when evicted."
     },
     "do": [
      {
       "action": "highlight",
       "target": "hitpol[1][2]"
      }
     ]
    },
    {
     "say": {
      "en": "Example: a loop writes the same block 10 times before it is evicted."
     },
     "do": [
      {
       "action": "show",
       "target": "loop"
      }
     ]
    },
    {
     "say": {
      "en": "Write-through makes 10 memory writes; write-back makes just 1 block write, at eviction."
     },
     "do": [
      {
       "action": "highlight",
       "target": "loop[0]"
      }
     ]
    },
    {
     "say": {
      "en": "So write-back saves memory bandwidth when a block is written many times."
     },
     "do": [
      {
       "action": "mark",
       "target": "hitpol[1]"
      }
     ]
    }
   ]
  },
