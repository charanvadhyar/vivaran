       "action": "highlight",
       "target": "diff[1..=2]"
      }
     ]
    },
    {
     "say": {
      "en": "The key exam point: who finds the parallelism. Superscalar hardware finds it while the program runs. A VLIW compiler finds it before."
     },
     "do": [
      {
       "action": "highlight",
       "target": "diff[3]"
      },
      {
       "action": "mark",
       "target": "diff[3][2]",
