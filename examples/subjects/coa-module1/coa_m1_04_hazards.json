 "scenes": [
  {
   "id": "intro",
   "steps": [
    {
     "say": {
      "en": "Last video, the pipeline finished one instruction every cycle. That was the ideal."
     },
     "do": [
      {
       "action": "write",
       "target": "head"
      },
      {
       "action": "replace",
       "target": "head",
       "text": "Pipeline hazards: finding them"
      }
     ]
    },
    {
     "say": {
      "en": "A hazard is anything that stops the next instruction from running in its planned cycle."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "hazard: the next instruction cannot run in its planned cycle"
      }
     ]
    },
    {
     "say": {
      "en": "This video is about finding hazards; the next one is about fixing them."
     },
     "do": [
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "stages"
      }
     ]
    },
    {
     "say": {
      "en": "The three kinds, then structural hazards and the three data dependences."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[0..=2]"
      }
     ]
    },
    {
     "say": {
      "en": "Then which dependences really cause trouble, control hazards, and one code sequence with every hazard marked."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[3..=5]"
      }
     ]
    }
   ]
  },
  {
   "id": "three",
   "steps": [
    {
     "say": {
      "en": "Stage 1: there are three kinds of hazard."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 1 of 6: three kinds"
      },
      {
       "action": "hide",
       "target": "stages"
      },
      {
       "action": "show",
       "target": "three"
      }
     ]
    },
    {
     "say": {
      "en": "Structural: two instructions need the same piece of hardware in the same cycle."
     },
     "do": [
      {
       "action": "highlight",
       "target": "three[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Data: an instruction needs a value that an earlier instruction has not produced yet."
     },
     "do": [
      {
       "action": "highlight",
       "target": "three[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Control: the pipeline must fetch the next instruction before it knows which way a branch goes."
     },
     "do": [
      {
       "action": "highlight",
       "target": "three[2]"
      }
     ]
    }
   ]
  },
  {
   "id": "structural",
   "steps": [
    {
     "say": {
      "en": "Stage 2, structural hazards. Suppose instructions and data share a single memory."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 2 of 6: structural hazards"
      },
      {
       "action": "hide",
       "target": "three"
      },
      {
       "action": "show",
       "target": "struct"
      }
     ]
    },
    {
     "say": {
      "en": "I1 is a load. In cycle 4 it is in MEM, reading data memory."
     },
     "do": [
      {
       "action": "advance",
       "target": "struct",
       "to": 4
      },
      {
       "action": "highlight",
       "target": "struct.b03"
      }
     ]
    },
    {
     "say": {
      "en": "In that same cycle 4, I4 is in IF, fetching its instruction from memory."
     },
     "do": [
      {
       "action": "highlight",
       "target": "struct.b30"
      }
     ]
    },
    {
     "say": {
      "en": "One memory cannot serve both in one cycle: that is a structural hazard."
     },
     "do": [
      {
       "action": "mark",
       "target": "struct.b03"
      },
      {
       "action": "mark",
       "target": "struct.b30"
      }
     ]
    },
    {
     "say": {
      "en": "The standard cure is separate instruction and data caches, so IF and MEM never compete."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "structural hazard: shared hardware · cure: duplicate it, e.g. split I- and D-caches"
      }
     ]
    },
    {
     "say": {
      "en": "The register file is shared too: ID reads it while WB writes it. Writing in the first half of the cycle and reading in the second avoids that clash."
     }
    }
   ]
  },
  {
   "id": "dependences",
   "steps": [
    {
     "say": {
      "en": "Stage 3: data hazards come from dependences between instructions. There are three kinds."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 3 of 6: RAW, WAR and WAW"
      },
      {
       "action": "hide",
       "target": "struct"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "kinds"
      }
     ]
    },
    {
     "say": {
      "en": "Name them by what the later instruction, j, does after the earlier one, i."
     },
     "do": [
      {
       "action": "highlight",
       "target": "kinds.c2"
      }
     ]
    },
    {
     "say": {
      "en": "RAW, read after write: j reads a register that i writes. j truly needs i's result, so it is called a true dependence."
     },
     "do": [
      {
       "action": "highlight",
       "target": "kinds[0]"
      }
     ]
    },
    {
     "say": {
      "en": "WAR, write after read: j writes a register that i still has to read. No value passes between them; only the name is shared. It is an anti-dependence."
     },
     "do": [
      {
       "action": "highlight",
       "target": "kinds[1]"
      }
     ]
    },
    {
     "say": {
      "en": "WAW, write after write: both write the same register, and the final value must be j's. It is an output dependence."
     },
     "do": [
      {
       "action": "highlight",
       "target": "kinds[2]"
      }
     ]
    },
    {
     "say": {
      "en": "WAR and WAW are called name dependences: renaming a register removes them. RAW cannot be renamed away."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "RAW = true dependence · WAR, WAW = name dependences, removable by renaming"
      }
     ]
    }
   ]
  },
  {
   "id": "which",
   "steps": [
    {
     "say": {
      "en": "Stage 4: a dependence is not always a hazard. It depends on the pipeline. Watch R1 here."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 4 of 6: which dependences are hazards"
      },
      {
       "action": "hide",
       "target": "kinds"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "show",
       "target": "raw"
      }
     ]
    },
    {
     "say": {
      "en": "I1 writes R1 in WB, in cycle 5."
     },
     "do": [
      {
       "action": "highlight",
       "target": "raw.r04"
      },
      {
       "action": "advance",
       "target": "raw",
       "to": 5
      }
     ]
    },
    {
     "say": {
      "en": "I2 reads R1 in its ID stage, in cycle 3, two cycles too early."
