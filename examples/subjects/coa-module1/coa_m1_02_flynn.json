       "target": "mimd.c2",
       "delay": 0.4
      },
      {
       "action": "mark",
       "target": "mimd.c3",
       "delay": 0.6
      }
     ]
    },
    {
     "say": {
      "en": "Multicore chips are MIMD with shared memory: all cores read and write one memory."
