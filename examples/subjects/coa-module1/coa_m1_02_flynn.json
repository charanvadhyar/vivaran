     "do": [
      {
       "action": "highlight",
       "target": "spmdx[1]"
      }
     ]
    },
    {
     "say": {
      "en": "And SPMD processors can take different branches, like core 0 here. That is why SPMD runs on MIMD hardware."
     },
     "do": [
      {
       "action": "highlight",
       "target": "spmdx[2]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "SPMD = one program on MIMD hardware, each processor on its own data"
      }
     ]
    }
