       "action": "highlight",
       "target": "trap[3]"
      }
     ]
    },
    {
     "say": {
      "en": "Flynn counts streams, not issue width. Pipelining and superscalar are instruction-level parallelism inside SISD."
     },
     "do": [
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
