   "region": "center",
   "language": "c",
   "lines": [
    "// (1) a polynomial: 3 multiplies, 2 adds = 5 flops",
    "y[i] = a*x[i]*x[i] + b*x[i] + c;      // DRAM: read x, write y = 16 bytes",
    "",
    "// (2) a 3-point average: 2 adds, 1 multiply = 3 flops",
    "B[i] = (A[i-1] + A[i] + A[i+1]) * third;"
