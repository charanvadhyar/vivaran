     "do": [
      {
       "action": "highlight",
       "target": "stages[0..=3]"
      }
     ]
    },
    {
     "say": {
      "en": "Then what masking costs, an if with an else, when very few elements are active, masks on other machines, and an exam question."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[4..=8]"
