    "      MUL.4D  F4,F4,F0",
    "      L.4D    F8,0(Ry)      ; 4 Y values",
    "      ADD.4D  F8,F8,F4",
    "      S.4D    F8,0(Ry)",
    "      DADDIU  Rx,Rx,#32     ; 32 bytes",
    "      DADDIU  Ry,Ry,#32",
    "      DSUBU   R20,R4,Rx",
    "      BNEZ    R20,Loop"
