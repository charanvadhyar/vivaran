    "    __m256d x = _mm256_loadu_pd(&X[i]);",
    "    __m256d y = _mm256_loadu_pd(&Y[i]);",
    "    y = _mm256_fmadd_pd(va, x, y);        // y = a*x + y, fused",
    "    _mm256_storeu_pd(&Y[i], y);",
    "}",
    "for (; i < n; i++) Y[i] = a * X[i] + Y[i];   // leftover elements"
