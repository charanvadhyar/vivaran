       "target": "rowt[3][4]",
       "value": "24",
       "delay": 0.36
      }
     ]
    },
    {
     "say": {
      "en": "Finally, add the products into one number: a reduction. 51. VMIPS does it with a few vector adds of halves, and RISC-V has a reduction instruction, vfredusum. Real codes often vectorize across many rows instead, to get longer vectors."
     },
     "do": [
      {
       "action": "mark_lines",
       "target": "row",
       "from": 6,
       "to": 7
