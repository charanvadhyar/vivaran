     "do": [
      {
       "action": "highlight",
       "target": "dup[3]"
      }
     ]
    },
    {
     "say": {
      "en": "So the compiler may vectorize this loop only if K has no duplicates. It usually cannot prove that, so the programmer must promise it, with a pragma. A histogram, where many elements land in the same bin, is the classic loop that breaks."
     },
     "do": [
      {
       "action": "highlight",
       "target": "dup[4]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
