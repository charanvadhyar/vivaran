    "VMIPS",
    "does"
   ],
   "rows": [
    [
     "gather",
     "LVI V1,(R1+V2)",
     "V1[i] = memory[R1 + V2[i]]: load from a list of addresses"
    ],
    [
     "scatter",
     "SVI (R1+V2),V1",
     "memory[R1 + V2[i]] = V1[i]: store to a list of addresses"
    ],
    [
     "the index vector",
     "V2",
     "loaded first, an ordinary vector of offsets"
    ],
    [
     "RISC-V V",
     "vluxei64 · vsuxei64",
     "indexed load and store"
    ]
   ]
  },
  {
   "id": "c",
   "type": "code",
   "region": "left",
   "language": "c",
   "lines": [
    "for (i = 0; i < n; i++)",
    "  A[K[i]] = A[K[i]] + C[M[i]];"
   ]
  },
  {
   "id": "code",
   "type": "code",
   "region": "center",
   "language": "asm",
   "lines": [
    "LV       Vk,Rk          ; load the index vector K",
    "LVI      Va,(Ra+Vk)     ; gather A[K[i]]",
    "LV       Vm,Rm          ; load the index vector M",
    "LVI      Vc,(Rc+Vm)     ; gather C[M[i]]",
    "ADDVV.D  Va,Va,Vc       ; add",
    "SVI      (Ra+Vk),Va     ; scatter back to A[K[i]]"
   ]
  },
