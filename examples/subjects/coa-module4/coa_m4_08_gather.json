   "id": "spmv",
   "type": "code",
   "region": "center",
   "language": "c",
   "lines": [
    "// y = A x, A in CSR",
    "for (i = 0; i < n; i++)",
    "    for (j = rowptr[i]; j < rowptr[i+1]; j++)",
    "        y[i] += val[j] * x[col[j]];     // x is read at scattered places"
   ]
