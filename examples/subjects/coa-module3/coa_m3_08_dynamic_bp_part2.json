       "target": "mn"
      },
      {
       "action": "show",
       "target": "dc"
      }
     ]
    },
    {
     "say": {
      "en": "If d is 2: b1 is taken, d stays 2, and b2 is taken too. If d is 0: b1 falls through and sets d to 1, so b2 falls through as well. Let d alternate 2, 0, 2, 0."
     },
     "do": [
      {
       "action": "hide",
       "target": "dc"
      },
      {
       "action": "show",
       "target": "dx"
