      {
       "action": "highlight",
       "target": "dx[1]",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "So the outcomes go: b1 taken, b2 taken, b1 not, b2 not, and so on. Every branch flips each time it runs."
     },
     "do": [
      {
       "action": "hide",
       "target": "dx"
      },
      {
       "action": "show",
       "target": "tr"
      },
      {
       "action": "highlight",
       "target": "tr[0..=1]"
      }
     ]
    },
    {
     "say": {
