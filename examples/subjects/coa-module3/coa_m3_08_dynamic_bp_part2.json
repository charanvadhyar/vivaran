  {
   "id": "tour",
   "steps": [
    {
     "say": {
      "en": "Stage 5: some branches are best predicted from their own past, like loops. Others from the global past, like correlated ifs. Why not use both?"
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 5 of 7: tournament predictors"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "hide",
       "target": "bits"
      },
      {
       "action": "show",
       "target": "tn"
      }
     ]
    },
    {
     "say": {
      "en": "A tournament predictor runs a local predictor, built on each branch's own history."
     },
     "do": [
      {
       "action": "highlight",
       "target": "tn[0]"
      }
     ]
    },
    {
     "say": {
      "en": "And a global predictor, built on the recent outcomes of all branches."
     },
     "do": [
      {
       "action": "highlight",
       "target": "tn[1]"
      }
     ]
    },
    {
     "say": {
      "en": "A selector, one more 2-bit counter per entry, decides which of the two to believe for this branch."
     },
     "do": [
      {
       "action": "highlight",
       "target": "tn[2]"
      }
     ]
    },
    {
     "say": {
      "en": "After the outcome is known: if one predictor was right and the other wrong, the selector moves one step toward the right one. If both were right or both wrong, it stays. So each branch drifts to the predictor that suits it."
     },
     "do": [
      {
       "action": "highlight",
       "target": "tn[3]"
      }
     ]
    },
    {
     "say": {
      "en": "An example. A selector at 10 leans toward the global predictor. On a branch where global is wrong and local is right, it drops to 01, now leaning local. If both are right next time, it stays at 01."
     },
     "do": [
      {
       "action": "mark",
       "target": "tn[2]"
      }
     ]
    },
    {
     "say": {
      "en": "A second local win takes it to 00, strongly local. It would take two global wins in a row to swing it back. The same saturating trick as the 2-bit counter, applied to the choice."
     },
     "do": [
      {
       "action": "mark",
       "target": "tn[3]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "tournament: local + global + a selector"
      }
     ]
    }
   ]
