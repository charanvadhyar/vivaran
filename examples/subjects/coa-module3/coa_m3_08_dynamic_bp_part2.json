    },
    {
     "say": {
      "en": "a: 4 counters of 2 bits per entry, times 1024: 8K bits. b: 8 counters of 2 bits is 16 bits per entry, and 8192 over 16 is 512 entries."
     },
     "do": [
      {
       "action": "hide",
       "target": "q"
      },
      {
