  {
   "id": "mn",
   "steps": [
    {
     "say": {
      "en": "Stage 2: the correlating, or two-level, predictor. It keeps a global history: the outcomes of the last m branches, whichever branches they were, in a shift register."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 2 of 7: the (m, n) predictor"
