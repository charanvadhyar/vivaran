  {
   "id": "trace",
   "steps": [
    {
     "say": {
      "en": "Stage 3: a trace. Two branches. b1 is taken when d is not 0, and b2 is taken when d is not 1."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 3 of 7: tracing a (1, 1) predictor"
