       "target": "ob"
      },
      {
       "action": "highlight",
       "target": "ob[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Take a loop of 10 iterations, run many times. Its branch is taken 9 times, then not taken once to exit."
     },
     "do": [
      {
       "action": "highlight",
       "target": "ob[0]"
      }
     ]
    },
    {
     "say": {
      "en": "On the last iteration the entry says taken, but the loop exits. Wrong. And now the entry flips to not taken."
     },
     "do": [
      {
       "action": "highlight",
       "target": "ob[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Next time the loop runs, its first branch is predicted not taken. Wrong again."
     },
     "do": [
      {
       "action": "highlight",
       "target": "ob[2]"
      }
     ]
    },
    {
     "say": {
      "en": "Two mistakes per 10 executions: 80 percent right, for a branch that is taken 90 percent of the time. One odd outcome costs two mispredictions."
     },
     "do": [
      {
       "action": "highlight",
       "target": "ob[3]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "1-bit: one exit costs two mistakes"
      }
     ]
    }
   ]
  },
  {
   "id": "twobit",
   "steps": [
    {
     "say": {
      "en": "Stage 4: the fix is a 2-bit saturating counter. Four states, from strongly taken down to strongly not taken."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 4 of 7: the 2-bit counter"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "hide",
       "target": "ob"
      },
      {
       "action": "show",
       "target": "fsm"
      }
     ]
    },
    {
     "say": {
      "en": "A taken branch counts up, stopping at 11. A not-taken branch counts down, stopping at 00."
     },
     "do": [
      {
       "action": "highlight",
       "target": "fsm.s3"
      },
      {
       "action": "highlight",
       "target": "fsm.s0",
       "delay": 0.4
      }
     ]
    },
    {
     "say": {
      "en": "The top two states predict taken; the bottom two, not taken."
     },
     "do": [
      {
       "action": "highlight",
       "target": "fsm.s3"
      },
      {
       "action": "highlight",
       "target": "fsm.s2",
       "delay": 0.2
      },
      {
       "action": "highlight",
       "target": "fsm.s1",
       "delay": 0.5
      },
      {
       "action": "highlight",
       "target": "fsm.s0",
       "delay": 0.7
      }
     ]
    },
    {
     "say": {
      "en": "The key: from strongly taken, one not-taken outcome only drops it to weakly taken. The prediction is still taken. It takes two wrong outcomes in a row to change its mind."
     },
     "do": [
      {
       "action": "highlight",
       "target": "fsm.s3->s2"
      },
      {
       "action": "highlight",
       "target": "fsm.s2",
       "delay": 0.4
      }
     ]
    },
    {
     "say": {
      "en": "The rules in one table."
     },
     "do": [
      {
       "action": "hide",
       "target": "fsm"
      },
      {
       "action": "show",
       "target": "fsx"
      },
      {
       "action": "highlight",
       "target": "fsx[0..=1]"
      }
     ]
    },
    {
     "say": {
      "en": "So on the loop of 10, the exit is mispredicted, but the counter only drops to weakly taken, and the next run's first branch is predicted right. 90 percent right."
     },
     "do": [
      {
       "action": "highlight",
       "target": "fsx[2..=3]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "2-bit: change the prediction only after two misses"
      }
     ]
    }
   ]
  },
