     "do": [
      {
       "action": "highlight",
       "target": "def[3]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "coherence: one address, one agreed history of writes"
      }
     ]
    }
   ]
  },
  {
   "id": "fix",
   "steps": [
    {
     "say": {
      "en": "Stage 6: the most common fix is write invalidate. Before a core writes, it makes sure it holds the only copy, by invalidating all the others."
