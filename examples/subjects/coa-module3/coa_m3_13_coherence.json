  {
   "id": "org",
   "steps": [
    {
     "say": {
      "en": "Stage 2: the simplest organisation. A few cores, each with its caches, share one memory through a bus or a switch."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 2 of 8: UMA and NUMA"
      },
      {
       "action": "hide",
       "target": "takeaway"
