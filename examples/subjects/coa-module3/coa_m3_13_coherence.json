     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 5 of 8: what coherence means"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "hide",
       "target": "pb"
      },
      {
       "action": "show",
       "target": "def"
