     ]
    },
    {
     "say": {
      "en": "Every address takes the same time to reach from every core. That is uniform memory access, UMA, also called a symmetric multiprocessor, SMP."
     },
     "do": [
      {
       "action": "hide",
       "target": "uma"
      },
      {
       "action": "show",
       "target": "org"
