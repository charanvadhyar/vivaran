       "action": "highlight",
       "target": "waste[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Horizontal waste: a cycle that issues fewer instructions than the machine's width, because this thread has too little parallelism right now."
     },
     "do": [
      {
       "action": "highlight",
       "target": "waste[1]"
      }
     ]
    },
    {
     "say": {
      "en": "Other threads, separate programs or separate parts of one program, are independent of this one. Their instructions can fill those slots with no dependence checks between threads."
