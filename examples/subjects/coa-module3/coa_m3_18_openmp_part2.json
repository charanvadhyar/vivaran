   "id": "cr",
   "type": "code",
   "region": "center",
   "language": "c",
   "lines": [
    "#pragma omp parallel for",
    "for (i = 0; i < n; i++) {",
    "  #pragma omp critical",
    "  { if (a[i] > best) best = a[i]; }   // any block, one thread at a time",
    "}",
    "",
    "#pragma omp parallel for",
    "for (i = 0; i < n; i++) {",
    "  #pragma omp atomic",
    "  count += (a[i] > 0);               // one update of one variable",
    "}"
   ]
