   "id": "br",
   "type": "code",
   "region": "center",
   "language": "c",
   "lines": [
    "#pragma omp parallel",
    "{",
    "  #pragma omp for nowait",
    "  for (i = 0; i < n; i++) a[i] = f(i);",
    "  #pragma omp for nowait",
    "  for (i = 0; i < n; i++) b[i] = g(i);    // independent of a: nowait is safe",
    "  #pragma omp barrier",
    "  #pragma omp for",
    "  for (i = 0; i < n; i++) c[i] = a[i] + b[n - 1 - i];  // needs all of a and b",
    "}"
   ]
