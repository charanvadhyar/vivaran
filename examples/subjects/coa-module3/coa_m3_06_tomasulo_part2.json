     "do": [
      {
       "action": "set",
       "target": "is[3][2]",
       "value": "4"
      },
      {
       "action": "set",
       "target": "is[3][3]",
       "value": "5–6",
       "delay": 0.25
      },
      {
       "action": "set",
       "target": "is[3][4]",
       "value": "7",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "The divide issues in 5, into Mult2. F6 is copied at issue: the old F6, from the first load. F0 must come from Mult1, so it waits for cycle 15."
     },
     "do": [
      {
       "action": "set",
       "target": "is[4][2]",
       "value": "5"
      },
      {
       "action": "highlight",
       "target": "is[2][4]",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "It starts in 16, runs 40 cycles to 55, and writes F10 in 56."
     },
     "do": [
      {
       "action": "set",
       "target": "is[4][3]",
       "value": "16–55"
      },
      {
       "action": "set",
       "target": "is[4][4]",
       "value": "56",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "The add issues in 6, into Add2. F8 comes from Add1 in cycle 7, so it starts in 8, finishes in 9, and writes F6 in 10."
