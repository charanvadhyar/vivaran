    },
    {
     "say": {
      "en": "The multiply issues in 3, into Mult1. F4 is ready and copied; F2 comes from Load2, so Qj is Load2. It hears F2 on the bus in cycle 4 and starts in 5."
     },
     "do": [
      {
       "action": "set",
       "target": "is[2][2]",
       "value": "3"
      },
      {
