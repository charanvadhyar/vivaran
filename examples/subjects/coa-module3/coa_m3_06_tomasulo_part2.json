     "do": [
      {
       "action": "set",
       "target": "is[2][4]",
       "value": "15"
      }
     ]
    },
    {
     "say": {
      "en": "The subtract issues in 4, into Add1. F6 was written in 3, so its value is copied straight away. F2 arrives in 4. It executes in 5 and 6, and writes F8 in 7."
