     "do": [
      {
       "action": "set",
       "target": "is[5][2]",
       "value": "6"
      },
      {
       "action": "set",
       "target": "is[5][3]",
       "value": "8–9",
       "delay": 0.25
      },
      {
       "action": "set",
       "target": "is[5][4]",
       "value": "10",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "Cycle 10, not 22. The add overwrites F6 while the divide still has not started. That is safe, because the divide copied the old F6 at issue, five cycles earlier."
