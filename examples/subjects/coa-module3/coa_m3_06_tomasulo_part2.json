     "say": {
      "en": "The second load: issued in 2. There are three load buffers, so no structural stall this time. It executes in 3, writes F2 in 4."
     },
     "do": [
      {
       "action": "set",
       "target": "is[1][2]",
       "value": "2"
      },
      {
       "action": "set",
       "target": "is[1][3]",
       "value": "3",
       "delay": 0.25
