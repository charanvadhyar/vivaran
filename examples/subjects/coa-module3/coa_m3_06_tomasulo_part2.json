       "action": "show",
       "target": "rules"
      },
      {
       "action": "highlight",
       "target": "rules[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Execution starts the cycle after the last operand appears on the common data bus. If both operands are ready at issue, it starts the very next cycle."
     },
     "do": [
      {
       "action": "highlight",
       "target": "rules[1]"
      }
     ]
    },
    {
     "say": {
      "en": "A result is written, on the bus, the cycle after execution ends. Only one result can use the bus each cycle."
     },
     "do": [
      {
       "action": "highlight",
       "target": "rules[2]"
      }
     ]
    },
    {
     "say": {
      "en": "Three load buffers, three store buffers, three add stations and two for multiply and divide. And the same latencies as the scoreboard video, so we can compare."
     },
     "do": [
      {
       "action": "highlight",
       "target": "rules[3..=4]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
