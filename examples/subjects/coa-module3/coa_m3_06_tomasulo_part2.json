  {
   "id": "rules",
   "steps": [
    {
     "say": {
      "en": "Stage 1: the rules. Issue is in order, one instruction per cycle, as long as a station of the right kind is free."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 1 of 7: the timing rules"
      },
      {
       "action": "hide",
       "target": "stages"
      },
