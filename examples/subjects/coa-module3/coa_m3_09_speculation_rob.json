       "action": "highlight",
       "target": "mp[5..=7]",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "The load in entry 6 had even finished. It does not matter: it never committed, so no register changed. Speculation was undone completely."
