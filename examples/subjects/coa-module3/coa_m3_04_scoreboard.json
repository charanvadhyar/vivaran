 "scenes": [
  {
   "id": "intro",
   "steps": [
    {
     "say": {
      "en": "So far the compiler arranged the instructions. Now the hardware does it, while the program runs, letting instructions start as soon as their operands are ready. The first such design was the scoreboard, in the CDC 6600 of 1964."
     },
     "do": [
      {
       "action": "write",
       "target": "head"
      },
      {
       "action": "replace",
       "target": "head",
       "text": "Scoreboarding"
      }
     ]
    },
    {
     "say": {
