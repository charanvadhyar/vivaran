     "do": [
      {
       "action": "highlight",
       "target": "steps[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Read operands: it waits until every source register has been written by its producer. That is where RAW hazards are resolved, and why instructions can now start out of order."
