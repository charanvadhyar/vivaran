     "do": [
      {
       "action": "set",
       "target": "tt[1][2]",
       "value": "M"
      },
      {
       "action": "set",
       "target": "tt[1][3]",
       "value": "I",
       "delay": 0.1
      },
      {
       "action": "set",
       "target": "tt[1][4]",
       "value": "I",
       "delay": 0.2
      },
      {
       "action": "set",
       "target": "tt[1][5]",
       "value": "BusUpgr",
       "delay": 0.4
      },
      {
       "action": "set",
       "target": "tt[1][6]",
       "value": "–",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "3: P2 reads X. A miss: BusRd. P1 snoops it, holds the block Modified, so it writes back and supplies it. Both end Shared."
     },
     "do": [
      {
       "action": "set",
       "target": "tt[2][2]",
       "value": "S"
      },
      {
       "action": "set",
       "target": "tt[2][3]",
       "value": "S",
       "delay": 0.1
      },
      {
       "action": "set",
       "target": "tt[2][4]",
       "value": "I",
       "delay": 0.2
      },
      {
       "action": "set",
       "target": "tt[2][5]",
       "value": "BusRd",
       "delay": 0.4
      },
      {
       "action": "set",
       "target": "tt[2][6]",
       "value": "P1 (writes back)",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "4: P3 writes X. A miss: BusRdX. P1 and P2 snoop it and invalidate. P3 is Modified. Memory is up to date from step 3, so it supplies the data."
     },
     "do": [
      {
       "action": "set",
       "target": "tt[3][2]",
       "value": "I"
      },
      {
       "action": "set",
       "target": "tt[3][3]",
       "value": "I",
       "delay": 0.1
      },
      {
       "action": "set",
       "target": "tt[3][4]",
       "value": "M",
       "delay": 0.2
      },
      {
       "action": "set",
       "target": "tt[3][5]",
       "value": "BusRdX",
       "delay": 0.4
      },
      {
       "action": "set",
       "target": "tt[3][6]",
       "value": "memory",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "5: P1 reads X again. A miss: P3 writes back and supplies it. P1 and P3 are Shared."
     },
     "do": [
      {
       "action": "set",
       "target": "tt[4][2]",
       "value": "S"
      },
      {
       "action": "set",
       "target": "tt[4][3]",
       "value": "I",
       "delay": 0.1
      },
      {
       "action": "set",
       "target": "tt[4][4]",
       "value": "S",
       "delay": 0.2
      },
      {
       "action": "set",
       "target": "tt[4][5]",
       "value": "BusRd",
       "delay": 0.4
      },
      {
       "action": "set",
       "target": "tt[4][6]",
       "value": "P3 (writes back)",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "6: P1 writes X: BusUpgr. P3 is invalidated, and P1 is Modified."
     },
     "do": [
      {
       "action": "set",
       "target": "tt[5][2]",
       "value": "M"
      },
      {
       "action": "set",
       "target": "tt[5][3]",
       "value": "I",
       "delay": 0.1
      },
      {
       "action": "set",
       "target": "tt[5][4]",
       "value": "I",
       "delay": 0.2
      },
      {
       "action": "set",
       "target": "tt[5][5]",
       "value": "BusUpgr",
       "delay": 0.4
      },
      {
       "action": "set",
       "target": "tt[5][6]",
       "value": "–",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "Six operations, six bus transactions. And step 2 was a waste: P1 broadcast an invalidation when it was the only holder."
     },
     "do": [
      {
       "action": "highlight",
       "target": "tt[1]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "MSI: 6 bus transactions"
      }
     ]
    }
   ]
  },
  {
   "id": "mesi",
   "steps": [
    {
     "say": {
      "en": "Stage 5: MESI fixes that waste with a fourth state, Exclusive."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 5 of 8: MESI"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "hide",
       "target": "tt"
      },
      {
       "action": "show",
       "target": "ex"
      },
      {
       "action": "highlight",
       "target": "ex[0]"
      }
     ]
    },
    {
     "say": {
      "en": "Exclusive means: only this cache has the block, and it is clean."
     },
     "do": [
      {
       "action": "mark",
       "target": "ex[0]"
      }
     ]
    },
    {
     "say": {
      "en": "When a read miss finds that no other cache has the block, the bus tells it so, and the block goes to Exclusive instead of Shared."
     },
     "do": [
      {
       "action": "highlight",
       "target": "ex[1]"
      }
     ]
    },
    {
     "say": {
      "en": "A write in Exclusive then goes to Modified silently. No bus transaction at all, because there is nobody to invalidate."
     },
     "do": [
      {
       "action": "highlight",
       "target": "ex[2]"
      }
     ]
    },
    {
     "say": {
      "en": "If another cache reads the block, Exclusive drops to Shared."
     },
     "do": [
      {
       "action": "highlight",
       "target": "ex[3]"
      }
     ]
    },
    {
     "say": {
