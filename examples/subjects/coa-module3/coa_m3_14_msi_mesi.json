  {
   "id": "intro",
   "steps": [
    {
     "say": {
      "en": "Write invalidate needs every cache to know when another wants to write. On a bus, the simplest way is to listen. This video traces the two classic snooping protocols, MSI and MESI, state by state."
     },
     "do": [
      {
       "action": "write",
       "target": "head"
      },
      {
       "action": "replace",
       "target": "head",
       "text": "Snooping protocols: MSI and MESI"
