    {
     "say": {
      "en": "Together, 3.5. Unrolling supplies independent instructions; scheduling puts them in the gaps. The useful work stays 3 per element; the waste falls from 6 to half a cycle."
     },
     "do": [
      {
       "action": "highlight",
       "target": "cmp[3]"
