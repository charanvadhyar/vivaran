  {
   "id": "lat",
   "steps": [
    {
     "say": {
      "en": "Stage 1: the rules. These are the textbook's latencies, given as stall cycles needed between a producer and the instruction that uses its result."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 1 of 8: the latencies"
      },
      {
       "action": "hide",
