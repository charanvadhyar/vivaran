      },
      {
       "action": "show",
       "target": "lat"
      }
     ]
    },
    {
     "say": {
      "en": "An FP add feeding another FP add needs 3 stall cycles in between. Feeding a store, 2."
     },
     "do": [
      {
       "action": "highlight",
       "target": "lat[0..=1]"
      }
     ]
    },
    {
     "say": {
      "en": "A load feeding an FP add needs 1. A load feeding a store, none."
     },
     "do": [
      {
       "action": "highlight",
       "target": "lat[2..=3]"
      }
     ]
    },
    {
     "say": {
      "en": "And an integer op feeding a branch needs 1, because the branch is resolved early, in decode. We ignore any extra branch penalty here."
     },
     "do": [
      {
       "action": "highlight",
       "target": "lat[4]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "a consumer must wait the producer's stall cycles"
      }
     ]
    }
   ]
  },
  {
   "id": "plain",
   "steps": [
    {
     "say": {
      "en": "Stage 2: the loop from the last video. It adds F2 to every element of an array, walking R1 downward 8 bytes at a time."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 2 of 8: the loop as written"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "hide",
       "target": "lat"
      },
      {
       "action": "show",
       "target": "c1"
      }
     ]
    },
    {
     "say": {
      "en": "The load issues in cycle 1. The add needs F0, so it waits 1 cycle, and issues in cycle 3."
     },
     "do": [
      {
       "action": "goto_line",
       "target": "c1",
       "line": 1
      },
      {
       "action": "mark_lines",
       "target": "c1",
       "from": 2,
