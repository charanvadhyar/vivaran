      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "queue → stations → units → CDB → registers and stations"
      }
     ]
    }
   ]
  },
  {
   "id": "steps",
   "steps": [
    {
     "say": {
      "en": "Stage 3: every instruction goes through three steps."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 3 of 8: three steps"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "hide",
       "target": "dg"
      },
      {
       "action": "show",
       "target": "st3"
      }
     ]
    },
    {
     "say": {
      "en": "Issue: take the next instruction, in order, if a station of its kind is free. For each source: if the value is ready, copy it; if not, record the tag of the station producing it. Then mark the destination register with this station's tag."
     },
     "do": [
      {
       "action": "highlight",
       "target": "st3[0]"
      },
      {
       "action": "highlight",
       "target": "st3[1]",
       "delay": 0.6
      }
     ]
    },
    {
     "say": {
      "en": "If no station is free, issue stalls: that is the only structural stall left."
     },
     "do": [
      {
       "action": "mark",
       "target": "st3[0..=1]"
      }
     ]
    },
    {
     "say": {
      "en": "Execute: watch the CDB until both operands have arrived, then run. RAW hazards are resolved here, by waiting."
     },
     "do": [
      {
       "action": "highlight",
       "target": "st3[2]"
      }
     ]
    },
    {
     "say": {
      "en": "Write result: put the value and the tag on the CDB. Every station and register waiting for that tag takes the value, and the station is freed."
     },
     "do": [
      {
       "action": "highlight",
       "target": "st3[3]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "issue: rename · execute: wait for RAW · write: broadcast"
      }
     ]
    }
   ]
  },
