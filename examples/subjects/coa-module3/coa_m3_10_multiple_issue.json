      },
      {
       "action": "highlight",
       "target": "asm[3]",
       "delay": 0.6
      }
     ]
    },
    {
     "say": {
      "en": "Here are the first two iterations. The load issues in 1 and executes in 2 and 3. The add must wait for it, executing in 5."
     },
     "do": [
      {
       "action": "hide",
       "target": "asm"
      },
      {
       "action": "show",
       "target": "tn"
      },
      {
       "action": "highlight",
