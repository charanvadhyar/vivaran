      }
     ]
    },
    {
     "say": {
      "en": "The machine: 2 instructions issue and 2 commit per cycle. A load takes 2 cycles, an integer operation 1. Without speculation, nothing after a branch may execute until the branch itself has executed."
     },
     "do": [
      {
       "action": "hide",
       "target": "lp"
      },
      {
       "action": "show",
