  {
   "id": "rec",
   "steps": [
    {
     "say": {
      "en": "Stage 1: the three classic traversals are the same recursion with the visit in a different place. Preorder visits the node before its subtrees."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 1 of 8: three recursive orders"
      },
      {
       "action": "hide",
       "target": "stages"
      },
      {
       "action": "show",
       "target": "rec"
      },
      {
       "action": "mark_lines",
       "target": "rec",
       "from": 1,
       "to": 5
      }
     ]
    },
    {
     "say": {
      "en": "Inorder visits it between the left and the right subtree. Postorder, after both."
     },
     "do": [
      {
       "action": "mark_lines",
       "target": "rec",
       "from": 7,
       "to": 7
      }
     ]
    },
    {
     "say": {
      "en": "Recursion is not required. An iterative inorder keeps its own stack: push nodes while going left, pop one, visit it, then go right. The stack holds the path back up, exactly what the recursion stored for us."
     },
     "do": [
      {
       "action": "mark_lines",
       "target": "rec",
       "from": 2,
       "to": 5
      }
     ]
    },
    {
     "say": {
      "en": "Each node is visited exactly once: Theta of n time. The recursion stack holds one frame per level: Theta of the height."
     },
     "do": [
      {
       "action": "mark_lines",
       "target": "rec",
       "from": 8,
       "to": 8
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "pre: N L R · in: L N R · post: L R N"
      }
     ]
    }
   ]
