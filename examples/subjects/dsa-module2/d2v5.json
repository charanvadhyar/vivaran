    [
     "colour it red",
     "black-heights stay equal: rule 5 is safe"
    ],
    [
     "only rules 2 or 4 can break",
     "z is the root, or z's parent is red"
    ],
    [
     "while z's parent is red",
     "apply one of three cases, looking at z's uncle"
    ],
    [
     "finally",
     "colour the root black"
    ]
   ]
  },
