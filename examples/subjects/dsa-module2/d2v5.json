     "1",
     "red",
     "parent, uncle → black; grandparent → red; z = grandparent"
    ],
    [
     "2",
     "black, z makes a bend",
     "rotate at the parent → case 3"
    ],
    [
     "3",
     "black, z makes a line",
     "rotate at the grandparent; swap their colours"
    ],
    [
     "cost",
     "",
     "case 1 may repeat; at most 2 rotations"
    ]
   ]
