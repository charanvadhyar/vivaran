 "scenes": [
  {
   "id": "intro",
   "steps": [
    {
     "say": {
      "en": "A water network, a road system, a data network: each link can carry only so much per second. How much can we move from one point to another in total? That is the maximum-flow problem, and Ford-Fulkerson answers it by repeatedly finding a path with room to spare."
     },
     "do": [
      {
       "action": "write",
       "target": "head"
      },
      {
       "action": "replace",
       "target": "head",
       "text": "Maximum flow: Ford-Fulkerson"
      }
     ]
    },
    {
     "say": {
      "en": "Here are the eight stages."
