       "target": "rn"
      }
     ]
    },
    {
     "say": {
      "en": "Suppose we first choose the path s, a, b, t, with bottleneck 2. Push 2 along it."
     },
     "do": [
      {
       "action": "mark",
       "target": "fn.s->a"
      },
      {
       "action": "mark",
       "target": "fn.a->b",
       "delay": 0.2
      },
      {
       "action": "mark",
       "target": "fn.b->t",
