       "target": "fn.a->b",
       "value": "0/2",
       "delay": 0.3
      },
      {
       "action": "set",
       "target": "fn.a->t",
       "value": "2/2",
       "delay": 0.5
      },
      {
       "action": "mark",
       "target": "fn.s"
