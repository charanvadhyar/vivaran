       "action": "set",
       "target": "fn.a->b",
       "value": "2/2",
       "delay": 0.7
      },
      {
       "action": "set",
       "target": "fn.b->t",
       "value": "2/2",
       "delay": 0.8
      }
     ]
    },
    {
     "say": {
      "en": "Those three edges are now full, so forwards they vanish from the residual network. But each can be undone: a back edge appears with capacity 2."
     },
     "do": [
      {
       "action": "remove",
       "target": "rn.s->a"
      },
      {
       "action": "remove",
       "target": "rn.a->b",
       "delay": 0.15
      },
      {
       "action": "remove",
       "target": "rn.b->t",
       "delay": 0.3
      },
      {
       "action": "add_edge",
       "target": "rn",
       "from": "a",
       "to": "s",
       "label": "2",
       "delay": 0.5
      },
      {
       "action": "add_edge",
       "target": "rn",
       "from": "b",
       "to": "a",
       "label": "2",
       "delay": 0.6
      },
      {
       "action": "add_edge",
       "target": "rn",
       "from": "t",
       "to": "b",
       "label": "2",
       "delay": 0.7
      }
     ]
    },
    {
     "say": {
      "en": "Without back edges we would be stuck at 2: in the original graph, every path from s to t now uses a full edge. In the residual network there is still a path: s, b, then back from b to a, then a, t."
     },
     "do": [
      {
       "action": "mark",
       "target": "rn.s->b"
      },
      {
       "action": "mark",
       "target": "rn.b->a",
       "delay": 0.25
      },
      {
       "action": "mark",
       "target": "rn.a->t",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "Push 2 along it. The step b to a is not real flow from b to a: it cancels the 2 we had sent from a to b. That edge goes back to 0."
     },
     "do": [
      {
       "action": "reset",
       "target": "fn.s->a"
      },
      {
       "action": "reset",
       "target": "fn.a->b"
      },
      {
       "action": "reset",
       "target": "fn.b->t"
