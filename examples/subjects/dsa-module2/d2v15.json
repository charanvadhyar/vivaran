     "do": [
      {
       "action": "show",
       "target": "stages"
      }
     ]
    },
    {
     "say": {
      "en": "Flow networks, residual networks, why we sometimes push flow backwards, and the method itself."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[0..=3]"
      }
     ]
    },
    {
     "say": {
      "en": "Then a full trace, the max-flow min-cut theorem, running time with Edmonds-Karp, and an exam question."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[4..=7]"
