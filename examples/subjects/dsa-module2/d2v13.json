      {
       "action": "highlight",
       "target": "lo[0]",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "At I every neighbour is visited, so DFS backs up, all the way to A, finding nothing new. A completely different order from BFS's A to J by distance."
