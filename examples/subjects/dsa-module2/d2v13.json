 "scenes": [
  {
   "id": "intro",
   "steps": [
    {
     "say": {
      "en": "Breadth-first search spreads out in rings. Depth-first search does the opposite: it follows one path as far as it can, then backs up and tries the next branch, like exploring a maze with one hand on the wall."
     },
     "do": [
      {
       "action": "write",
       "target": "head"
      },
      {
       "action": "replace",
       "target": "head",
       "text": "Depth-first search"
      }
     ]
    },
    {
     "say": {
      "en": "The order in which it finishes vertices reveals cycles and dependency orders. This video traces it and puts it to work."
     }
    },
    {
     "say": {
      "en": "Here are the eight stages."
     },
     "do": [
      {
       "action": "show",
       "target": "stages"
      }
     ]
    },
    {
     "say": {
      "en": "The idea, the algorithm with discovery and finish times, a trace, and the four kinds of edge."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[0..=3]"
      }
     ]
    },
    {
     "say": {
      "en": "Then cycles, topological sorting, DFS against BFS, and an exam question."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[4..=7]"
      }
     ]
    }
   ]
  },
  {
