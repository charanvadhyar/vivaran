     "do": [
      {
       "action": "highlight",
       "target": "pb[2]"
      }
     ]
    },
    {
     "say": {
      "en": "For a hundred thousand elements and a hundred thousand operations, the first two can need about 10 to the 10 steps. The segment tree needs a few million."
     },
     "do": [
      {
       "action": "highlight",
       "target": "pb[3]"
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "both operations in O(log n)"
