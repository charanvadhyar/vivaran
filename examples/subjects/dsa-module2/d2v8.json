  {
   "id": "update",
   "steps": [
    {
     "say": {
      "en": "Stage 5: set A of 3 to 7, an increase of 4. Only the nodes whose intervals contain position 3 change: one per level, from the leaf up to the root."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
       "text": "Stage 5 of 7: an update"
      },
      {
       "action": "hide",
       "target": "takeaway"
      },
      {
       "action": "hide",
       "target": "t0"
      },
      {
       "action": "show",
       "target": "t1"
      },
      {
       "action": "highlight",
       "target": "t1.v11"
      }
     ]
    },
    {
     "say": {
      "en": "The leaf becomes 7. 2 to 3 becomes 12. 0 to 3 becomes 15. The root becomes 28."
     },
     "do": [
      {
       "action": "mark",
       "target": "t1.v11"
      },
      {
       "action": "mark",
       "target": "t1.v5",
       "delay": 0.25
      },
      {
       "action": "mark",
       "target": "t1.v2",
       "delay": 0.5
      },
      {
       "action": "mark",
       "target": "t1.v1",
       "delay": 0.75
      }
     ]
    },
    {
     "say": {
      "en": "The update in code: walk down to the leaf, set it, and recompute each sum on the way back up."
     },
