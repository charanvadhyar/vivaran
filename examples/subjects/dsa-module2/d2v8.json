 "scenes": [
  {
   "id": "intro",
   "steps": [
    {
     "say": {
      "en": "Many problems ask the same question again and again about different parts of an array: what is the sum, or the smallest value, between positions l and r, while the array keeps changing. The segment tree answers each question, and makes each change, in logarithmic time."
     },
     "do": [
      {
       "action": "write",
       "target": "head"
      },
      {
       "action": "replace",
       "target": "head",
       "text": "Segment trees"
