      {
       "action": "show",
       "target": "stages"
      }
     ]
    },
    {
     "say": {
      "en": "The problem, the shape of the tree, building it, and answering a range query."
     },
     "do": [
      {
       "action": "highlight",
       "target": "stages[0..=3]"
