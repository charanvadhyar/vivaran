  {
   "id": "code",
   "type": "code",
   "region": "right",
   "language": "text",
   "lines": [
    "BFS(G, s)",
    "  for each vertex u: u.d = ∞;  u.π = nil",
    "  s.d = 0;  Q = [s]",
    "  while Q is not empty",
    "      u = DEQUEUE(Q)",
    "      for each v adjacent to u",
    "          if v.d == ∞                // not yet discovered",
    "              v.d = u.d + 1;  v.π = u",
    "              ENQUEUE(Q, v)"
   ]
  },
