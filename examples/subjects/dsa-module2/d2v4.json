     "one right rotation at the unbalanced node"
    ],
    [
     "RR",
     "the right subtree of the right child",
     "one left rotation"
    ],
    [
     "LR",
     "the right subtree of the left child",
     "left-rotate the child, then right-rotate the node"
    ],
    [
     "RL",
     "the left subtree of the right child",
     "right-rotate the child, then left-rotate the node"
    ],
    [
     "after the fix",
     "the subtree has its old height again",
     "nothing above it changes: at most 2 rotations per insert"
    ]
   ]
  },
  {
   "id": "rr",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "LEFT-ROTATE(x)                 // x is too heavy on the right",
    "    y = x.right",
    "    x.right = y.left           // y's left subtree moves across to x",
    "    y.left = x                 // x becomes y's left child",
    "    update heights of x, then y; y takes x's place",
    "",
    "keys in order before and after:  x < y.left < y  — unchanged"
   ]
  },
