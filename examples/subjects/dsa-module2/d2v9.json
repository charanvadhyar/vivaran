     ]
    },
    {
     "say": {
      "en": "Now 4 sits at index 4, with children 2 and 8. Swap with 8."
     },
     "do": [
      {
       "action": "set",
       "target": "t1.h4",
       "value": "8"
      },
      {
       "action": "set",
       "target": "t1.h9",
       "value": "4"
      },
      {
       "action": "swap",
       "a": "a1[3]",
       "b": "a1[8]"
