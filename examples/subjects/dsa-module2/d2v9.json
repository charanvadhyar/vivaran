      {
       "action": "highlight",
       "target": "t1.h9",
       "delay": 0.5
      }
     ]
    },
    {
     "say": {
      "en": "At index 9, 4 is a leaf: done. Each swap moves one level down, so MAX-HEAPIFY costs O of the height: O of log n."
     },
     "do": [
      {
       "action": "mark",
       "target": "t1.h9"
