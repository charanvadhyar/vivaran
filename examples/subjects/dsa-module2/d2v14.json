  {
   "id": "rx",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "RELAX(u, v, w)",
    "    if v.d > u.d + w(u, v)          // a cheaper way into v, through u?",
    "        v.d = u.d + w(u, v)",
    "        v.π = u",
    "",
    "BELLMAN-FORD(G, w, s)",
    "    every v.d = ∞, v.π = nil;  s.d = 0",
    "    repeat n − 1 times",
    "        for each edge (u, v): RELAX(u, v, w)",
    "    for each edge (u, v)",
    "        if v.d > u.d + w(u, v): return FALSE    // negative cycle",
    "    return TRUE"
   ]
  },
