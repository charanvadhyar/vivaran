   "id": "fibm",
   "type": "math",
   "region": "center",
   "lines": [
    "\"FIB(n) = FIB(n − 1) + FIB(n − 2): calls(5) = 15\"",
    "\"calls\"(n) = 2 F(n + 1) - 1 quad \"FIB(30): 2,692,537 calls\"",
