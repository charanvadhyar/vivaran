   "id": "code",
   "type": "code",
   "region": "left",
   "language": "text",
   "lines": [
    "INSERTION-SORT(A, n)",
    "  for j = 2 to n",
    "      key = A[j]",
    "      // insert A[j] into the sorted A[1 .. j-1]",
    "      i = j - 1",
    "      while i > 0 and A[i] > key",
    "          A[i + 1] = A[i]        // shift right",
    "          i = i - 1",
    "      A[i + 1] = key"
   ]
