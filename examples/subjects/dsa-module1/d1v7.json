 "scenes": [
  {
   "id": "intro",
   "steps": [
    {
     "say": {
      "en": "A stack lets you touch only one end. That one restriction makes it the structure behind function calls, undo buttons, the back button of your browser, and every calculator. This video builds a stack and uses it to evaluate expressions."
