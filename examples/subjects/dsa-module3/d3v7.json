  {
   "id": "algo",
   "steps": [
    {
     "say": {
      "en": "Stage 5: Cormen's MST-PRIM. Every key starts at infinity, except the root's, 0."
     },
     "do": [
      {
       "action": "replace",
       "target": "head",
