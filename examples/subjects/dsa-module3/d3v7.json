     ]
    },
    {
     "say": {
      "en": "All vertices go into a min-priority queue, ordered by key."
     },
     "do": [
      {
       "action": "mark_lines",
       "target": "pc",
       "from": 4,
       "to": 4
      }
     ]
    },
    {
     "say": {
      "en": "Repeatedly extract the vertex with the smallest key: it joins the tree by the edge to its π."
     },
     "do": [
      {
       "action": "mark_lines",
       "target": "pc",
       "from": 5,
       "to": 6
      }
     ]
    },
    {
     "say": {
      "en": "Then update its neighbours still outside: if the new edge is cheaper than a neighbour's key, lower the key and set π. That is DECREASE-KEY."
     },
     "do": [
      {
       "action": "mark_lines",
       "target": "pc",
       "from": 7,
       "to": 9
      }
     ]
    },
    {
     "say": {
      "en": "Why check that v is still in Q? A vertex already in the tree must never be re-attached: its edge is final. Without the check, a later edge could overwrite the parent of a vertex already in the tree, and the tree would fall apart."
     },
     "do": [
      {
       "action": "mark_lines",
       "target": "pc",
       "from": 8,
       "to": 8
      }
     ]
    },
    {
     "say": {
      "en": "At the end, the tree is the set of edges from each vertex to its π."
     },
     "do": [
      {
       "action": "mark_lines",
       "target": "pc",
       "from": 11,
       "to": 11
      },
      {
       "action": "write",
       "target": "takeaway"
      },
      {
       "action": "replace",
       "target": "takeaway",
       "text": "extract-min, then decrease-key the neighbours"
      }
     ]
    }
