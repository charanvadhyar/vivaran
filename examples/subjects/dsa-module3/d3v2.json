     "≤ pivot"
    ],
    [
     "A[i+1 .. j−1]",
     "> pivot"
    ],
    [
     "A[j .. r−1]",
     "not yet looked at"
    ],
    [
     "A[r]",
     "the pivot"
    ]
   ]
  },
