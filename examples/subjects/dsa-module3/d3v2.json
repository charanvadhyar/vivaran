  {
   "id": "pc",
   "type": "code",
   "region": "left",
   "language": "text",
   "lines": [
    "PARTITION(A, p, r)",
    "    x = A[r]                    // the pivot: the last element",
    "    i = p − 1                   // end of the ≤ x region",
    "    for j = p to r − 1",
    "        if A[j] ≤ x",
    "            i = i + 1",
    "            exchange A[i] with A[j]",
    "    exchange A[i + 1] with A[r]  // pivot to its place",
    "    return i + 1"
   ]
  },
  {
   "id": "inv",
   "type": "table",
   "region": "right",
   "columns": [
    "while j moves",
    ""
   ],
   "rows": [
