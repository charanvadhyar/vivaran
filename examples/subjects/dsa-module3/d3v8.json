  {
   "id": "kc",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "MST-KRUSKAL(G, w)",
    "    A = ∅",
    "    for each vertex v:  MAKE-SET(v)",
    "    sort the edges into non-decreasing order of weight w",
    "    for each edge (u, v), in that order",
    "        if FIND-SET(u) ≠ FIND-SET(v)",
    "            A = A ∪ {(u, v)}",
    "            UNION(u, v)",
    "    return A"
   ]
  },
