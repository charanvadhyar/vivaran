   "rows": [
    [
     "each set",
     "a tree of parent pointers; the root is the representative"
    ],
    [
     "union by rank",
     "hang the shorter tree under the taller: height stays O(log n)"
    ],
    [
     "path compression",
     "after FIND-SET, point every node on the path straight at the root"
    ],
    [
     "both together",
     "m operations take O(m α(n)); α grows so slowly it is ≤ 4 in practice"
    ]
   ]
