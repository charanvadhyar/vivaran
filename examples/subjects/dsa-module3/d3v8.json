     "say": {
      "en": "Prim grows one tree outward from a start vertex. Kruskal takes the opposite view: forget the start, look at the cheapest connections anywhere in the graph, and keep every one that does not close a loop. On the same graph, it finds a minimum spanning tree of the same weight."
     },
     "do": [
