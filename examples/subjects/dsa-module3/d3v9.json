  {
   "id": "hc",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "HUFFMAN(C)",
    "    n = |C|;   Q = C                       // a min-priority queue on frequency",
    "    for i = 1 to n − 1",
    "        allocate a new node z",
    "        z.left = x = EXTRACT-MIN(Q)",
    "        z.right = y = EXTRACT-MIN(Q)",
    "        z.freq = x.freq + y.freq",
    "        INSERT(Q, z)",
    "    return EXTRACT-MIN(Q)                 // the root",
    "",
    "binary heap: n − 1 rounds × O(log n) = O(n log n)"
   ]
  },
  {
   "id": "op",
   "type": "table",
   "region": "center",
   "columns": [
    "why Huffman is optimal",
    ""
   ],
   "rows": [
    [
     "greedy choice",
     "some optimal tree has the two rarest characters as sibling leaves at the greatest depth"
    ],
    [
     "reason",
     "swapping a rarer character deeper never increases Σ freq × depth"
    ],
    [
     "optimal substructure",
     "merge them into one character z of their summed frequency: the rest is the same problem, smaller"
    ],
    [
     "so",
     "every merge keeps an optimal tree within reach: the final tree is optimal among prefix codes"
    ]
   ]
  },
