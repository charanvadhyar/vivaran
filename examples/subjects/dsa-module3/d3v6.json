   "rows": [
    [
     "let G be greedy's set, O an optimal set",
     "suppose they first differ at job a, the most profitable job where they disagree"
    ],
    [
     "case 1: a in G, not in O",
     "a fits where O schedules some cheaper job b; swap b for a: profit does not drop"
    ],
    [
     "case 2: a in O, not in G",
     "greedy rejected a only because all slots ≤ dₐ held more profitable jobs, which O also has: then O is infeasible"
    ],
    [
     "repeat",
     "O turns into G without losing profit: G is optimal"
    ],
    [
     "two ingredients",
