  {
   "id": "ac",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "JOB-SEQUENCING(d, p, n)",
    "    sort the jobs so that p[1] ≥ p[2] ≥ … ≥ p[n]",
    "    slot[1 .. dmax] = empty",
    "    for i = 1 to n",
    "        for t = min(dmax, d[i]) downto 1",
    "            if slot[t] is empty",
    "                slot[t] = i;  break",
    "    return slot",
    "",
    "sort: O(n log n)   ·   slot search: O(n) per job   ·   total O(n²);  O(n log n) with disjoint sets"
   ]
  },
