  {
   "id": "ms",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "MERGE-SORT(A, p, r)",
    "    if p < r                          // more than one element",
    "        q = ⌊(p + r) / 2⌋                // divide",
    "        MERGE-SORT(A, p, q)             // conquer the left half",
    "        MERGE-SORT(A, q + 1, r)         // conquer the right half",
    "        MERGE(A, p, q, r)               // combine",
    "",
    "first call:  MERGE-SORT(A, 1, n)"
   ]
  },
