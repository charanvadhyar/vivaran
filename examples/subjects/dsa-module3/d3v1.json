  {
   "id": "mc",
   "type": "code",
   "region": "left",
   "language": "text",
   "lines": [
    "MERGE(A, p, q, r)",
    "    n1 = q − p + 1;   n2 = r − q",
    "    copy A[p .. q] into L[1 .. n1],  A[q+1 .. r] into R[1 .. n2]",
    "    L[n1 + 1] = ∞;   R[n2 + 1] = ∞          // sentinels",
    "    i = 1;   j = 1",
    "    for k = p to r",
    "        if L[i] ≤ R[j]",
    "            A[k] = L[i];   i = i + 1",
    "        else A[k] = R[j];   j = j + 1"
   ]
  },
