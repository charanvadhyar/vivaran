  {
   "id": "ac",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "APPROX-VERTEX-COVER(G)",
    "    C = ∅;   E' = G.E",
    "    while E' is not empty",
    "        let (u, v) be any edge of E'",
    "        C = C ∪ {u, v}                     // take BOTH ends",
    "        remove from E' every edge touching u or v",
    "    return C",
    "",
    "with adjacency lists: O(V + E)"
   ]
  },
