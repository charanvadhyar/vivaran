    },
    {
     "say": {
      "en": "CLIQUE to VERTEX-COVER, then to HAM-CYCLE, and finally to TSP, the reduction we just saw."
     },
     "do": [
      {
       "action": "highlight",
       "target": "tree.vc"
      },
      {
       "action": "highlight",
       "target": "tree.hc",
