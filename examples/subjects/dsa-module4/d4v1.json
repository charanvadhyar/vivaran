  {
   "id": "mc",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "MATRIX-CHAIN-ORDER(p, n)",
    "    for i = 1 to n:  m[i, i] = 0",
    "    for l = 2 to n                         // chain length",
    "        for i = 1 to n − l + 1",
    "            j = i + l − 1;   m[i, j] = ∞",
    "            for k = i to j − 1",
    "                q = m[i, k] + m[k+1, j] + p[i−1] · p[k] · p[j]",
    "                if q < m[i, j]:  m[i, j] = q;  s[i, j] = k",
    "    return m and s",
    "",
    "three nested loops: Θ(n³) time,  Θ(n²) space"
   ]
  },
