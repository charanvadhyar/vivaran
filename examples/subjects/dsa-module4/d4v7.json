  {
   "id": "why",
   "type": "table",
   "region": "center",
   "columns": [
    "why A* is optimal",
    ""
   ],
   "rows": [
    [
     "claim",
     "with an admissible h, the first time the goal is expanded, its g is the least cost"
    ],
    [
     "suppose a cheaper path exists",
     "some node n on it is still waiting in the queue"
    ],
    [
     "then",
     "f(n) = g(n) + h(n) ≤ the cheaper cost < g(goal) = f(goal)"
    ],
    [
     "so",
     "n would have been expanded before the goal: contradiction"
    ],
    [
     "consistent h",
     "h(u) ≤ cost(u, v) + h(v): each cell is expanded at most once (ours is)"
    ]
   ]
  },
  {
   "id": "ac",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "A-STAR(grid, s, t)",
    "    g[s] = 0;   insert s into Q with key f = h(s)",
    "    while Q is not empty",
    "        u = EXTRACT-MIN(Q)                  // least f",
    "        if u == t:  return g[t] and the path by parent links",
    "        mark u closed",
    "        for each of the 8 neighbours v of u, not X and not closed",
    "            if g[u] + cost(v) < g[v]",
    "                g[v] = g[u] + cost(v);  parent[v] = u",
    "                insert or decrease v in Q with key g[v] + h(v)",
    "    return \"no path\"",
    "",
    "binary heap: O(E log V); a better h only reduces the nodes expanded"
   ]
  },
