  {
   "id": "pc",
   "type": "code",
   "region": "center",
   "language": "text",
   "lines": [
    "PLACE(k, i)          // can queen k go in column i, given x[1 .. k−1]?",
    "    for j = 1 to k − 1",
    "        if x[j] == i                      return false   // same column",
    "        if |x[j] − i| == |j − k|          return false   // same diagonal",
    "    return true",
    "",
    "NQUEENS(k, n)        // place queens k .. n",
    "    for i = 1 to n",
    "        if PLACE(k, i)",
    "            x[k] = i",
    "            if k == n:  print x[1 .. n]",
    "            else NQUEENS(k + 1, n)"
   ]
  },
